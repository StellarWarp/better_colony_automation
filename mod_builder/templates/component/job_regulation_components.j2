{# 岗位调控面板 GUI 组件宏 #}

{% macro category_button(cat, x, y, w, h) -%}
{% set cat_key = cat | upper %}
        effectButtonType = { name = "jr_cat_btn_{{ cat }}_selected" position = { x = {{ x }} y = {{ y }} } size = { x = {{ w }} y = {{ h }} } font = "cg_16b" buttonText = "BCA_JR_CAT_{{ cat_key }}" format = center vertical_alignment = center quadTextureSprite = "GFX_bca_button_standard_enabled" effect = "bca_jr_select_category_{{ cat }}_selected" }
        effectButtonType = { name = "jr_cat_btn_{{ cat }}_unselected" position = { x = {{ x }} y = {{ y }} } size = { x = {{ w }} y = {{ h }} } font = "cg_16b" buttonText = "BCA_JR_CAT_{{ cat_key }}" format = center vertical_alignment = center quadTextureSprite = "GFX_bca_button_standard_disabled" effect = "bca_jr_select_category_{{ cat }}_unselected" }
{%- endmacro %}

{% macro category_bar(categories, x, y, btn_w, btn_gap, btn_h) -%}
{% for cat in categories %}
        {{ category_button(cat, x + loop.index0 * (btn_w + btn_gap), y, btn_w, btn_h) }}
{% endfor %}
{%- endmacro %}

{% macro table_header(x, y) -%}
        effectButtonType = { name = "jr_hdr_job"    position = { x = {{ x + 10 }}  y = {{ y }} } size = { x = 210 y = 22 } font = "cg_16b" buttonText = "BCA_JR_HEADER_JOB"      format = left vertical_alignment = center alwaysTransparent = yes effect = "bca_tab_visible_1" }
        effectButtonType = { name = "jr_hdr_wf"     position = { x = {{ x + 230 }} y = {{ y }} } size = { x = 130 y = 22 } font = "cg_16b" buttonText = "BCA_JR_HEADER_WORKFORCE" format = right vertical_alignment = center alwaysTransparent = yes effect = "bca_tab_visible_1" }
        effectButtonType = { name = "jr_hdr_output" position = { x = {{ x + 405 }} y = {{ y }} } size = { x = 270 y = 22 } font = "cg_16b" buttonText = "BCA_JR_HEADER_OUTPUT"    format = left vertical_alignment = center alwaysTransparent = yes effect = "bca_tab_visible_1" }
{%- endmacro %}

{% macro slot_row(s_name, x, y, row_w, row_h) -%}
        effectButtonType = { name = "jr_slot_bg_{{ s_name }}" position = { x = {{ x }} y = {{ y }} } size = { x = {{ row_w }} y = {{ row_h - 2 }} } quadTextureSprite = "GFX_interface_list_dark" effect = "bca_jr_slot_visible_{{ s_name }}" alwaysTransparent = yes }
        effectButtonType = { name = "jr_slot_icon_{{ s_name }}" position = { x = {{ x + 8 }} y = {{ y + 7 }} } size = { x = 30 y = 30 } font = "cg_16b" buttonText = "BCA_JR_SLOT_{{ s_name }}_ICON" format = center vertical_alignment = center alwaysTransparent = yes effect = "bca_jr_slot_visible_{{ s_name }}" }
        effectButtonType = { name = "jr_slot_name_{{ s_name }}" position = { x = {{ x + 44 }} y = {{ y + 6 }} } size = { x = 176 y = 30 } font = "cg_16b" buttonText = "BCA_JR_SLOT_{{ s_name }}_NAME" format = left vertical_alignment = center alwaysTransparent = yes effect = "bca_jr_slot_visible_{{ s_name }}" }
        effectButtonType = { name = "jr_slot_wf_{{ s_name }}" position = { x = {{ x + 230 }} y = {{ y + 6 }} } size = { x = 130 y = 30 } font = "cg_16b" buttonText = "BCA_JR_SLOT_{{ s_name }}_WF" format = right vertical_alignment = center alwaysTransparent = yes effect = "bca_jr_slot_visible_{{ s_name }}" }
        effectButtonType = { name = "jr_slot_output_{{ s_name }}" position = { x = {{ x + 405 }} y = {{ y + 6 }} } size = { x = 270 y = 30 } font = "cg_16b" buttonText = "BCA_JR_SLOT_{{ s_name }}_OUTPUT" format = left vertical_alignment = center alwaysTransparent = yes effect = "bca_jr_slot_visible_{{ s_name }}" }
        effectButtonType = { name = "jr_slot_toggle_{{ s_name }}_enabled" position = { x = {{ x + row_w - 88 }} y = {{ y + 6 }} } size = { x = 76 y = 30 } font = "cg_16b" buttonText = "BCA_GLOBAL_SETTINGS_ENABLED" format = center vertical_alignment = center quadTextureSprite = "GFX_bca_button_standard_enabled" effect = "bca_jr_slot_toggle_{{ s_name }}_enabled" }
        effectButtonType = { name = "jr_slot_toggle_{{ s_name }}_disabled" position = { x = {{ x + row_w - 88 }} y = {{ y + 6 }} } size = { x = 76 y = 30 } font = "cg_16b" buttonText = "BCA_GLOBAL_SETTINGS_DISABLED" format = center vertical_alignment = center quadTextureSprite = "GFX_bca_button_standard_disabled" effect = "bca_jr_slot_toggle_{{ s_name }}_disabled" }
{%- endmacro %}

{% macro slot_list(slots, x, start_y, row_h, row_w) -%}
{% for s in range(slots) %}
{% set s_name = "s%d" % (s + 1) %}
{% set s_y = start_y + s * row_h %}
        {{ slot_row(s_name, x, s_y, row_w, row_h) }}
{% endfor %}
{%- endmacro %}
