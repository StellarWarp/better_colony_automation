        size = { x = {{ action_button_width }} y = {{ action_button_height }} }
        font = "cg_16b"
        buttonText = "BCA_GLOBAL_SETTINGS_APPLY_ENABLE"
        format = center
        vertical_alignment = center
        tooltipText = "{{ apply_enable_tooltip }}"
        quadTextureSprite = "GFX_bca_button_standard_disabled"
        effect = "{{ apply_enable_effect }}"
    }
    effectButtonType = {
        name = "{{ name }}_apply_disable"
        position = { x = {{ x + apply_disable_x }} y = {{ y + 12 }} }
        size = { x = {{ action_button_width }} y = {{ action_button_height }} }
        font = "cg_16b"
        buttonText = "BCA_GLOBAL_SETTINGS_APPLY_DISABLE"
        format = center
        vertical_alignment = center
        tooltipText = "{{ apply_disable_tooltip }}"
        quadTextureSprite = "GFX_bca_button_standard_disabled"
        effect = "{{ apply_disable_effect }}"
    }
{%- endmacro %}

{% macro choice_row(name, text, tooltip, x, y, width=320, height=40, button_width=56, button_gap=8, options=[], label_effect="") -%}
    {% set button_height = height - 8 %}
    {% set padding_x = 14 %}
    {% set option_count = options | length %}
    {% set total_button_width = option_count * button_width + (option_count - 1) * button_gap %}
    {% set button_start_x = width - total_button_width - padding_x %}
    effectButtonType = {
        name = "{{ name }}_bg"
        position = { x = {{ x }} y = {{ y }} }
        size = { x = {{ width }} y = {{ height }} }
        quadTextureSprite = "GFX_interface_list_dark"
        alwaysTransparent = yes
        {% if label_effect %}
            effect = "{{ label_effect }}"
        {% endif %}
    }
    {% if text %}
        effectButtonType = {
            name = "{{ name }}_label"
            font = "cg_16b"
            buttonText = "{{ text }}"
            position = { x = {{ x + padding_x }} y = {{ y }} }
            size = { x = {{ button_start_x - padding_x - 12 }} y = {{ height }} }
            format = left
            vertical_alignment = center
            alwaysTransparent = yes
            {% if label_effect %}
                effect = "{{ label_effect }}"
            {% endif %}
        }
    {% endif %}
    {% for option in options %}
        {% set option_x = x + button_start_x + loop.index0 * (button_width + button_gap) %}
        {% set option_tooltip = option.tooltip if option.tooltip is defined else tooltip %}
        effectButtonType = {
            name = "{{ name }}_{{ option.name }}_selected"
            position = { x = {{ option_x }} y = {{ y + 4 }} }
            size = { x = {{ button_width }} y = {{ button_height }} }
            font = "cg_16b"
            buttonText = "{{ option.text }}"
            format = center
            vertical_alignment = center
            tooltipText = "{{ option_tooltip }}"
            quadTextureSprite = "GFX_bca_button_standard_enabled"
            effect = "{{ option.effect }}_selected"
        }
        effectButtonType = {
            name = "{{ name }}_{{ option.name }}_unselected"
            position = { x = {{ option_x }} y = {{ y + 4 }} }
            size = { x = {{ button_width }} y = {{ button_height }} }
            font = "cg_16b"
            buttonText = "{{ option.text }}"
            format = center
            vertical_alignment = center
            tooltipText = "{{ option_tooltip }}"
            quadTextureSprite = "GFX_bca_button_standard_disabled"
            effect = "{{ option.effect }}_unselected"
        }
    {% endfor %}
{%- endmacro %}

{% macro tab_row(name, x, y, width, height, options, button_gap=2, inner_padding=14) -%}
    {% set option_count = options | length %}
    {% set total_gap = (option_count - 1) * button_gap %}
    {% set button_area_x = x + inner_padding %}
    {% set button_area_width = width - inner_padding * 2 %}
    {% set base_button_width = (button_area_width - total_gap) // option_count %}
    {% set button_height = height - 8 %}
    effectButtonType = {
        name = "{{ name }}_bg"
        position = { x = {{ x }} y = {{ y }} }
        size = { x = {{ width }} y = {{ height }} }
        quadTextureSprite = "GFX_interface_list_dark"
        alwaysTransparent = yes
    }
    {% set ns = namespace(cursor = button_area_x) %}
    {% for option in options %}
        {% if loop.last %}
            {% set button_width = x + width - inner_padding - ns.cursor %}
        {% else %}
            {% set button_width = base_button_width %}
        {% endif %}
        effectButtonType = {
            name = "{{ name }}_{{ option.name }}_selected"
            position = { x = {{ ns.cursor }} y = {{ y + 4 }} }
            size = { x = {{ button_width }} y = {{ button_height }} }
            font = "cg_16b"
            buttonText = "{{ option.text }}"
            format = center
            vertical_alignment = center
            quadTextureSprite = "GFX_bca_button_standard_enabled"
            effect = "{{ option.effect }}_selected"
        }
        effectButtonType = {
            name = "{{ name }}_{{ option.name }}_unselected"
            position = { x = {{ ns.cursor }} y = {{ y + 4 }} }
            size = { x = {{ button_width }} y = {{ button_height }} }
            font = "cg_16b"
            buttonText = "{{ option.text }}"
            format = center
            vertical_alignment = center
            quadTextureSprite = "GFX_bca_button_standard_disabled"
            effect = "{{ option.effect }}_unselected"
        }
        {% set ns.cursor = ns.cursor + button_width + button_gap %}
    {% endfor %}
{%- endmacro %}

