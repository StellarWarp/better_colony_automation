{% macro auto_demolition_row(
    name,
    text,
    x,
    y,
    default_enable_current_effect = "",
    default_enable_target_effect = "",
    default_disable_current_effect = "",
    default_disable_target_effect = "",
    default_enable_current_tooltip = "",
    default_enable_target_tooltip = "",
    default_disable_current_tooltip = "",
    default_disable_target_tooltip = "",
    apply_enable_effect = "",
    apply_disable_effect = "",
    apply_enable_tooltip = "",
    apply_disable_tooltip = "",
    status_text = "",
    width = 812,
    height = 54,
    label_width = 212,
    default_button_width = 96,
    action_button_width = 92,
    button_gap = 8,
    column_gap = 18,
    show_default = true
) -%}
{% set padding_x = 18 %}
{% set default_button_height = 30 %}
{% set action_button_height = 30 %}
{% set status_x = padding_x + 2 %}
{% set status_y = 29 %}
{% set status_height = 16 %}
{% set status_width = 224 %}
{% set apply_disable_x = width - padding_x - action_button_width %}
{% set apply_enable_x = apply_disable_x - button_gap - action_button_width %}
{% if show_default %}
{% set default_disable_x = apply_enable_x - column_gap - default_button_width %}
{% set default_enable_x = default_disable_x - button_gap - default_button_width %}
{% set label_max_width = default_enable_x - padding_x - 18 %}
{% else %}
{% set label_max_width = apply_enable_x - padding_x - 18 %}
{% endif %}
        containerWindowType = {
            name = "{{ name }}_row"
            position = { x = {{ x }} y = {{ y }} }
            size = { width = {{ width }} height = {{ height }} }

            background = {
                name = "background"
                spriteType = "GFX_interface_list_dark"
                alwaysTransparent = yes
            }

            instantTextBoxType = {
                name = "{{ name }}_label"
                font = "cg_16b"
                text = "{{ text }}"
                position = { x = {{ padding_x }} y = 4 }
                maxWidth = {{ label_max_width }}
                maxHeight = 20
                fixedSize = yes
                format = left
                vertical_alignment = center
                alwaysTransparent = yes
            }
{% if status_text %}
            effectButtonType = {
                name = "{{ name }}_status"
                position = { x = {{ status_x }} y = {{ status_y }} }
                size = { x = {{ status_width }} y = {{ status_height }} }
                font = "cg_16b"
                buttonText = "{{ status_text }}"
                text_color_code = "H"
                alwaysTransparent = yes
            }
{% endif %}
{% if show_default %}
            effectButtonType = {
                name = "{{ name }}_default_enable_current"
                position = { x = {{ default_enable_x }} y = 12 }
                size = { x = {{ default_button_width }} y = {{ default_button_height }} }
                font = "cg_16b"
                buttonText = "BCA_GLOBAL_SETTINGS_DEFAULT_ON"
                tooltipText = "{{ default_enable_current_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_enabled"
                effect = "{{ default_enable_current_effect }}"
            }
            effectButtonType = {
                name = "{{ name }}_default_enable_target"
                position = { x = {{ default_enable_x }} y = 12 }
                size = { x = {{ default_button_width }} y = {{ default_button_height }} }
                font = "cg_16b"
                buttonText = "BCA_GLOBAL_SETTINGS_DEFAULT_ON"
                tooltipText = "{{ default_enable_target_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_disabled"
                effect = "{{ default_enable_target_effect }}"
            }
            effectButtonType = {
                name = "{{ name }}_default_disable_current"
                position = { x = {{ default_disable_x }} y = 12 }
                size = { x = {{ default_button_width }} y = {{ default_button_height }} }
                font = "cg_16b"
                buttonText = "BCA_GLOBAL_SETTINGS_DEFAULT_OFF"
                tooltipText = "{{ default_disable_current_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_enabled"
                effect = "{{ default_disable_current_effect }}"
            }
            effectButtonType = {
                name = "{{ name }}_default_disable_target"
                position = { x = {{ default_disable_x }} y = 12 }
                size = { x = {{ default_button_width }} y = {{ default_button_height }} }
                font = "cg_16b"
                buttonText = "BCA_GLOBAL_SETTINGS_DEFAULT_OFF"
                tooltipText = "{{ default_disable_target_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_disabled"
                effect = "{{ default_disable_target_effect }}"
            }
{% endif %}
            effectButtonType = {
                name = "{{ name }}_apply_enable"
                position = { x = {{ apply_enable_x }} y = 12 }
                size = { x = {{ action_button_width }} y = {{ action_button_height }} }
                font = "cg_16b"
                buttonText = "BCA_GLOBAL_SETTINGS_APPLY_ENABLE"
                tooltipText = "{{ apply_enable_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_disabled"
                effect = "{{ apply_enable_effect }}"
            }
            effectButtonType = {
                name = "{{ name }}_apply_disable"
                position = { x = {{ apply_disable_x }} y = 12 }
                size = { x = {{ action_button_width }} y = {{ action_button_height }} }
                font = "cg_16b"
                buttonText = "BCA_GLOBAL_SETTINGS_APPLY_DISABLE"
                tooltipText = "{{ apply_disable_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_disabled"
                effect = "{{ apply_disable_effect }}"
            }
        }
{%- endmacro %}

{% macro choice_row(name, text, tooltip, x, y, width=320, height=40, button_width=56, button_gap=8, options=[]) -%}
{% set button_height = height - 8 %}
{% set padding_x = 14 %}
{% set option_count = options | length %}
{% set total_button_width = option_count * button_width + (option_count - 1) * button_gap %}
{% set button_start_x = width - total_button_width - padding_x %}
        containerWindowType = {
            name = "{{ name }}_row"
            position = { x = {{ x }} y = {{ y }} }
            size = { width = {{ width }} height = {{ height }} }

            background = {
                name = "background"
                spriteType = "GFX_interface_list_dark"
                alwaysTransparent = yes
            }

            instantTextBoxType = {
                name = "{{ name }}_label"
                font = "cg_16b"
                text = "{{ text }}"
                position = { x = {{ padding_x }} y = 0 }
                maxWidth = {{ button_start_x - padding_x - 12 }}
                maxHeight = {{ height }}
                fixedSize = yes
                format = left
                vertical_alignment = center
                alwaysTransparent = yes
            }
{% for option in options %}
{% set option_x = button_start_x + loop.index0 * (button_width + button_gap) %}
{% set option_tooltip = option.tooltip if option.tooltip is defined else tooltip %}
            effectButtonType = {
                name = "{{ name }}_{{ option.name }}_selected"
                position = { x = {{ option_x }} y = 4 }
                size = { x = {{ button_width }} y = {{ button_height }} }
                font = "cg_16b"
                buttonText = "{{ option.text }}"
                tooltipText = "{{ option_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_enabled"
                effect = "{{ option.effect }}_selected"
            }
            effectButtonType = {
                name = "{{ name }}_{{ option.name }}_unselected"
                position = { x = {{ option_x }} y = 4 }
                size = { x = {{ button_width }} y = {{ button_height }} }
                font = "cg_16b"
                buttonText = "{{ option.text }}"
                tooltipText = "{{ option_tooltip }}"
                quadTextureSprite = "GFX_bca_button_standard_disabled"
                effect = "{{ option.effect }}_unselected"
            }
{% endfor %}
        }
{%- endmacro %}

