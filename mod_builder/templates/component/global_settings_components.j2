{% macro section_title(name, text, x, y, width=300) -%}
    instantTextBoxType = {
        name = "{{ name }}"
        font = "malgun_goth_24"
        text = "{{ text }}"
        position = { x = {{ x }} y = {{ y }} }
        maxWidth = {{ width }}
        maxHeight = 28
        fixedSize = yes
        format = left
        vertical_alignment = center
        alwaysTransparent = yes
    }
{%- endmacro %}

{% macro sub_title(name, text, x, y, width=300) -%}
