    }
{%- endmacro %}

{% macro toggle_row(name, text, tooltip, effect_prefix, x, y, width=260, height=40, button_width=104, label_effect="") -%}
    {% set button_height = height - 8 %}
    {% set padding_x = 14 %}
    {% set button_x = width - button_width - padding_x %}
    effectButtonType = {
        name = "{{ name }}_bg"
        position = { x = {{ x }} y = {{ y }} }
        size = { x = {{ width }} y = {{ height }} }
        quadTextureSprite = "GFX_interface_list_dark"
        alwaysTransparent = yes
        {% if label_effect %}
            effect = "{{ label_effect }}"
        {% endif %}
    }
    effectButtonType = {
        name = "{{ name }}_label"
        font = "cg_16b"
        buttonText = "{{ text }}"
        position = { x = {{ x + padding_x }} y = {{ y }} }
        size = { x = {{ button_x - padding_x - 12 }} y = {{ height }} }
        format = left
        vertical_alignment = center
        alwaysTransparent = yes
        {% if label_effect %}
            effect = "{{ label_effect }}"
        {% endif %}
