{% macro toggle_row(name, text, tooltip, effect_prefix, x, y, width=260, height=40, button_width=104) -%}
{% set button_height = height - 8 %}
{% set padding_x = 14 %}
{% set button_x = width - button_width - padding_x %}
        containerWindowType = {
            name = "{{ name }}_row"
            position = { x = {{ x }} y = {{ y }} }
            size = { width = {{ width }} height = {{ height }} }

            background = {
                name = "background"
                spriteType = "GFX_interface_list_dark"
                alwaysTransparent = yes
            }

            instantTextBoxType = {
                name = "{{ name }}_label"
                font = "cg_16b"
                text = "{{ text }}"
                position = { x = {{ padding_x }} y = 0 }
                maxWidth = {{ button_x - padding_x - 12 }}
                maxHeight = {{ height }}
                fixedSize = yes
                format = left
                vertical_alignment = center
                alwaysTransparent = yes
