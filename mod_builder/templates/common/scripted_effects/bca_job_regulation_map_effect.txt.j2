# submod job_regulation
{# Phase 8: 槽位映射（参数化 effect 减少编译压力） #}
{% set regulated = job_regulation_config.regulated_jobs %}
{% set slots = job_regulation_config.display_slots | default(15) %}
{% set categories = job_regulation_config.categories %}
{% set resources = job_regulation_config.resources %}
{% set display_numbers = [
    "active_workforce",
    "assigned_workforce",
    "capacity_workforce",
    "pop_productive_workforce",
    "productive_workforce",
    "automated_capacity_workforce",
    "automated_productive_workforce",
    "pop_capacity_limit",
    "total_job_count",
    "free_job_count",
    "open_job_count",
    "open_total_capacity",
    "automation_rate",
    "pop_efficiency_delta",
    "automated_efficiency_delta",
    "total_efficiency_delta",
    "closable_capacity_workforce",
    "job_change",
    ] %}

bca_jr_locate_job_colonies = {
    optimize_memory
    every_owned_colony = {
        limit = {
            OR = {
                check_modifier_value = {
                    modifier = job_$JOB$_add
                    value > 0
                }
                any_owned_pop_job = {
                    has_job_type = $JOB$
                    colony = {
                        check_variable_arithmetic = {
                            which = value:bca_jr_num_pops_assigned_to_job|JOB|prev|
                            value > 0
                        }
                    }
                }
            }
        }
        set_variable = {
            which = bca_jr_locate_job_add
            value = modifier:job_$JOB$_add
        }
        set_variable = { which = bca_jr_locate_pops value = 0 }
        every_owned_pop_job = {
            limit = {
                has_job_type = $JOB$
            }
            colony = {
                set_variable = {
                    which = bca_jr_locate_pops
                    value = value:bca_jr_num_pops_assigned_to_job|JOB|prev|
                }
            }
        }
        divide_variable = { which = bca_jr_locate_job_add value = 1000 }
        divide_variable = { which = bca_jr_locate_pops value = 1000 }
        round_variable_to_closest = {
            which = bca_jr_locate_job_add
            value = 0.1
        }
        round_variable_to_closest = {
            which = bca_jr_locate_pops
            value = 0.1
        }
        owner = {
            #create_message = {
            #    type = MESSAGE_BCA_JOB_LOCATE
            #    days = 1
            #    localization = MESSAGE_BCA_JOB_LOCATE_DESC
            #    target = prev.carrier
            #    variable = {
            #        type = name
            #        localization = PLANET
            #        scope = prev.carrier
            #    }
            #    variable = {
            #        type = key
            #        value = job_$JOB$
            #        localization = JOB_NAME
            #    }
            #    variable = {
            #        type = variable
            #        varname = bca_jr_locate_pops
            #        localization = POPS
            #        scope = prev.carrier
            #    }
            #    variable = {
            #        type = variable
            #        varname = bca_jr_locate_job_add
            #        localization = JOBS
            #        scope = prev.carrier
            #    }
            #}
            create_message = {
                type = MESSAGE_BCA_JOB_LOCATE
                days = 1
                localization = MESSAGE_BCA_JOB_LOCATE_DESC
                target = prev
                variable = {
                    type = name
                    localization = PLANET
                    scope = prev
                }
                variable = {
                    type = key
                    value = job_$JOB$
                    localization = JOB_NAME
                }
                variable = {
                    type = variable
                    varname = bca_jr_locate_pops
                    localization = POPS
                    scope = prev
                }
                variable = {
                    type = variable
                    varname = bca_jr_locate_job_add
                    localization = JOBS
                    scope = prev
                }
            }
        }
        clear_variable = bca_jr_locate_job_add
        clear_variable = bca_jr_locate_pops
    }
}

bca_jr_locate_slot_job = {
    optimize_memory
    {% for entry in regulated %}
        if = {
            limit = { has_country_flag = bca_jr_slot_$SLOT_NAME$_job_{{ entry.job }} }
            bca_jr_locate_job_colonies = { JOB = {{ entry.job }} }
        }
    {% endfor %}
}

bca_jr_set_slot_job_mode_flags = {
    optimize_memory
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_auto
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_manual
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_empty
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_full
    if = {
        limit = { has_country_flag = bca_jr_mode_empty_$JOB$ }
        set_country_flag = bca_jr_slot_$SLOT_NAME$_mode_empty
    }
    else_if = {
        limit = { has_country_flag = bca_jr_mode_full_$JOB$ }
        set_country_flag = bca_jr_slot_$SLOT_NAME$_mode_full
    }
    else_if = {
        limit = { has_country_flag = bca_jr_mode_manual_$JOB$ }
        set_country_flag = bca_jr_slot_$SLOT_NAME$_mode_manual
    }
    else = {
        set_country_flag = bca_jr_slot_$SLOT_NAME$_mode_auto
    }
}

bca_jr_cycle_job_mode = {
    optimize_memory
    if = {
        limit = { has_country_flag = bca_jr_mode_empty_$JOB$ }
        remove_country_flag = bca_jr_mode_manual_$JOB$
        remove_country_flag = bca_jr_mode_empty_$JOB$
        set_country_flag = bca_jr_mode_full_$JOB$
    }
    else_if = {
        limit = { has_country_flag = bca_jr_mode_full_$JOB$ }
        remove_country_flag = bca_jr_mode_manual_$JOB$
        remove_country_flag = bca_jr_mode_empty_$JOB$
        remove_country_flag = bca_jr_mode_full_$JOB$
    }
    else_if = {
        limit = { has_country_flag = bca_jr_mode_manual_$JOB$ }
        remove_country_flag = bca_jr_mode_manual_$JOB$
        set_country_flag = bca_jr_mode_empty_$JOB$
        remove_country_flag = bca_jr_mode_full_$JOB$
    }
    else = {
        set_country_flag = bca_jr_mode_manual_$JOB$
        remove_country_flag = bca_jr_mode_empty_$JOB$
        remove_country_flag = bca_jr_mode_full_$JOB$
    }
}

bca_jr_cycle_slot_job_mode = {
    optimize_memory
    {% for entry in regulated %}
        if = {
            limit = { has_country_flag = bca_jr_slot_$SLOT_NAME$_job_{{ entry.job }} }
            bca_jr_cycle_job_mode = { JOB = {{ entry.job }} }
            bca_jr_set_slot_job_mode_flags = { SLOT_NAME = $SLOT_NAME$ JOB = {{ entry.job }} }
        }
    {% endfor %}
}

bca_jr_clear_country_job_totals = {
    optimize_memory
    {% for entry in regulated %}
        clear_variable = bca_jr_total_assigned_workforce_{{ entry.job }}
        clear_variable = bca_jr_total_capacity_workforce_{{ entry.job }}
        clear_variable = bca_jr_total_pop_productive_workforce_{{ entry.job }}
        clear_variable = bca_jr_total_productive_workforce_{{ entry.job }}
        clear_variable = bca_jr_total_automated_capacity_workforce_{{ entry.job }}
        clear_variable = bca_jr_total_automated_productive_workforce_{{ entry.job }}
        clear_variable = bca_jr_total_pop_capacity_limit_{{ entry.job }}
        clear_variable = bca_jr_total_job_count_{{ entry.job }}
        clear_variable = bca_jr_total_free_job_count_{{ entry.job }}
        clear_variable = bca_jr_total_open_job_count_{{ entry.job }}
        clear_variable = bca_jr_total_closable_capacity_workforce_{{ entry.job }}
        {% for resource in resources %}
            clear_variable = bca_jr_total_output_{{ entry.job }}_{{ resource }}
        {% endfor %}
    {% endfor %}
}

{# 清除所有槽位映射 flag #}
bca_jr_clear_slot_mapping_for_slot = {
    optimize_memory
    {% for entry in regulated %}
        remove_country_flag = bca_jr_slot_$SLOT_NAME$_job_{{ entry.job }}
    {% endfor %}
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mapped
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_auto
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_manual
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_empty
    remove_country_flag = bca_jr_slot_$SLOT_NAME$_mode_full
    clear_variable = bca_jr_slot_$SLOT_NAME$_active_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_assigned_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_capacity_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_pop_productive_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_productive_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_automated_capacity_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_automated_productive_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_pop_capacity_limit
    clear_variable = bca_jr_slot_$SLOT_NAME$_total_job_count
    clear_variable = bca_jr_slot_$SLOT_NAME$_free_job_count
    clear_variable = bca_jr_slot_$SLOT_NAME$_open_job_count
    clear_variable = bca_jr_slot_$SLOT_NAME$_open_total_capacity
    clear_variable = bca_jr_slot_$SLOT_NAME$_automation_rate
    clear_variable = bca_jr_slot_$SLOT_NAME$_pop_efficiency_delta
    clear_variable = bca_jr_slot_$SLOT_NAME$_automated_efficiency_delta
    clear_variable = bca_jr_slot_$SLOT_NAME$_total_efficiency_delta
    clear_variable = bca_jr_slot_$SLOT_NAME$_closable_capacity_workforce
    clear_variable = bca_jr_slot_$SLOT_NAME$_job_change
    {% for resource in resources %}
        clear_variable = bca_jr_slot_$SLOT_NAME$_output_{{ resource }}
    {% endfor %}
}

bca_jr_clear_slot_mapping = {
    optimize_memory
    {% for s in range(slots) %}
        {% set s_name = "s%d" % (s + 1) %}
        bca_jr_clear_slot_mapping_for_slot = { SLOT_NAME = {{ s_name }} }
    {% endfor %}
    {% for entry in regulated %}
        remove_country_flag = bca_jr_slot_mapped_{{ entry.job }}
    {% endfor %}
    set_variable = { which = bca_jr_display_count value = 0 }
}

bca_jr_normalize_job_filters = {
    optimize_memory
    if = {
        limit = {
            NOT = { has_country_flag = bca_jr_filter_all }
            NOT = { has_country_flag = bca_jr_filter_other }
            {% for resource in resources %}
                NOT = { has_country_flag = bca_jr_filter_{{ resource }} }
            {% endfor %}
        }
        set_country_flag = bca_jr_filter_all
    }
}

bca_jr_prepare_cached_sort_scores = {
    optimize_memory
    {% for entry in regulated %}
        if = {
            limit = {
                bca_jr_job_has_display_stats = { JOB = {{ entry.job }} }
                bca_jr_job_matches_selected_filters = { JOB = {{ entry.job }} }
            }
            set_variable = { which = bca_jr_cached_sort_score_{{ entry.job }} value = value:bca_jr_sort_score_{{ entry.job }} }
        }
    {% endfor %}
}

bca_jr_clear_cached_sort_scores = {
    optimize_memory
    {% for entry in regulated %}
        clear_variable = bca_jr_cached_sort_score_{{ entry.job }}
    {% endfor %}
}

{# 找最佳候选：遍历所有未映射岗位，取排序分数最大值 #}
bca_jr_find_best_for_slot = {
    optimize_memory
    clear_variable = bca_jr_best_score
    remove_country_flag = bca_jr_has_best_score
    {% for entry in regulated %}
        if = {
            limit = {
                NOT = { has_country_flag = bca_jr_slot_mapped_{{ entry.job }} }
                is_variable_set = bca_jr_cached_sort_score_{{ entry.job }}
                NOT = { has_country_flag = bca_jr_has_best_score }
            }
            set_variable = { which = bca_jr_best_score value = bca_jr_cached_sort_score_{{ entry.job }} }
            set_country_flag = bca_jr_has_best_score
        }
        if = {
            limit = {
                NOT = { has_country_flag = bca_jr_slot_mapped_{{ entry.job }} }
                is_variable_set = bca_jr_cached_sort_score_{{ entry.job }}
                has_country_flag = bca_jr_has_best_score
                check_variable_arithmetic = { which = bca_jr_cached_sort_score_{{ entry.job }} value > bca_jr_best_score }
            }
            set_variable = { which = bca_jr_best_score value = bca_jr_cached_sort_score_{{ entry.job }} }
        }
    {% endfor %}
}

{# 填入当前槽位：匹配 best_score 的第一个未映射岗位 #}
bca_jr_fill_slot_job_stats = {
    optimize_memory
    set_country_flag = bca_jr_slot_$SLOT_NAME$_job_$JOB$
    set_country_flag = bca_jr_slot_$SLOT_NAME$_mapped
    set_country_flag = bca_jr_slot_mapped_$JOB$
    bca_jr_set_slot_job_mode_flags = { SLOT_NAME = $SLOT_NAME$ JOB = $JOB$ }
    {% for number in display_numbers if number != "open_total_capacity" and not number.endswith("_delta") and number != "automation_rate" %}
        if = {
            {% if number == "active_workforce" %}
                limit = {
                    OR = {
                        is_variable_set = bca_jr_total_assigned_workforce_$JOB$
                        is_variable_set = bca_jr_total_automated_capacity_workforce_$JOB$
                    }
                }
                set_variable = { which = bca_jr_slot_$SLOT_NAME$_active_workforce value = 0 }
                if = {
                    limit = { is_variable_set = bca_jr_total_assigned_workforce_$JOB$ }
                    add_variable = { which = bca_jr_slot_$SLOT_NAME$_active_workforce value = bca_jr_total_assigned_workforce_$JOB$ }
                }
                if = {
                    limit = { is_variable_set = bca_jr_total_automated_capacity_workforce_$JOB$ }
                    add_variable = { which = bca_jr_slot_$SLOT_NAME$_active_workforce value = bca_jr_total_automated_capacity_workforce_$JOB$ }
                }
            {% elif number == "job_change" %}
                limit = { is_variable_set = bca_jr_monthly_job_change_$JOB$ }
                set_variable = { which = bca_jr_slot_$SLOT_NAME$_{{ number }} value = bca_jr_monthly_job_change_$JOB$ }
            {% elif number == "total_job_count" %}
                limit = { is_variable_set = bca_jr_total_job_count_$JOB$ }
                set_variable = { which = bca_jr_slot_$SLOT_NAME$_{{ number }} value = bca_jr_total_job_count_$JOB$ }
            {% else %}
                limit = { is_variable_set = bca_jr_total_{{ number }}_$JOB$ }
                set_variable = { which = bca_jr_slot_$SLOT_NAME$_{{ number }} value = bca_jr_total_{{ number }}_$JOB$ }
            {% endif %}
        }
    {% endfor %}
    if = {
        limit = { is_variable_set = bca_jr_total_open_job_count_$JOB$ }
        set_variable = { which = bca_jr_slot_$SLOT_NAME$_open_total_capacity value = bca_jr_total_open_job_count_$JOB$ }
    }
    if = {
        limit = { is_variable_set = bca_jr_total_automated_capacity_workforce_$JOB$ }
        add_variable = { which = bca_jr_slot_$SLOT_NAME$_open_total_capacity value = bca_jr_total_automated_capacity_workforce_$JOB$ }
    }
    set_variable = { which = bca_jr_slot_$SLOT_NAME$_automation_rate value = 0 }
    if = {
        limit = {
            check_variable = { which = bca_jr_slot_$SLOT_NAME$_total_job_count value > 0 }
            is_variable_set = bca_jr_total_automated_capacity_workforce_$JOB$
        }
        set_variable = { which = bca_jr_slot_$SLOT_NAME$_automation_rate value = bca_jr_total_automated_capacity_workforce_$JOB$ }
        multiply_variable = { which = bca_jr_slot_$SLOT_NAME$_automation_rate value = 100 }
        divide_variable = { which = bca_jr_slot_$SLOT_NAME$_automation_rate value = bca_jr_slot_$SLOT_NAME$_total_job_count }
    }
    if = {
        limit = { is_variable_set = bca_jr_total_pop_productive_workforce_$JOB$ }
        set_variable = { which = bca_jr_slot_$SLOT_NAME$_pop_efficiency_delta value = bca_jr_total_pop_productive_workforce_$JOB$ }
        if = {
            limit = { is_variable_set = bca_jr_total_capacity_workforce_$JOB$ }
            subtract_variable = { which = bca_jr_slot_$SLOT_NAME$_pop_efficiency_delta value = bca_jr_total_capacity_workforce_$JOB$ }
        }
    }
    if = {
        limit = { is_variable_set = bca_jr_total_automated_productive_workforce_$JOB$ }
        set_variable = { which = bca_jr_slot_$SLOT_NAME$_automated_efficiency_delta value = bca_jr_total_automated_productive_workforce_$JOB$ }
        if = {
            limit = { is_variable_set = bca_jr_total_automated_capacity_workforce_$JOB$ }
            subtract_variable = { which = bca_jr_slot_$SLOT_NAME$_automated_efficiency_delta value = bca_jr_total_automated_capacity_workforce_$JOB$ }
        }
    }
    if = {
        limit = { is_variable_set = bca_jr_total_productive_workforce_$JOB$ }
        set_variable = { which = bca_jr_slot_$SLOT_NAME$_total_efficiency_delta value = bca_jr_total_productive_workforce_$JOB$ }
        if = {
            limit = { is_variable_set = bca_jr_slot_$SLOT_NAME$_open_total_capacity }
            subtract_variable = { which = bca_jr_slot_$SLOT_NAME$_total_efficiency_delta value = bca_jr_slot_$SLOT_NAME$_open_total_capacity }
        }
    }
    {% for resource in resources %}
        if = {
            limit = {
                is_variable_set = bca_jr_total_output_$JOB$_{{ resource }}
                check_variable = { which = bca_jr_total_output_$JOB$_{{ resource }} value > 0 }
            }
            set_variable = { which = bca_jr_slot_$SLOT_NAME$_output_{{ resource }} value = bca_jr_total_output_$JOB$_{{ resource }} }
        }
    {% endfor %}
}

bca_jr_fill_current_slot = {
    optimize_memory
    {% for entry in regulated %}
        if = {
            limit = {
                NOT = { has_country_flag = bca_jr_slot_mapped_{{ entry.job }} }
                is_variable_set = bca_jr_cached_sort_score_{{ entry.job }}
                check_variable_arithmetic = { which = bca_jr_cached_sort_score_{{ entry.job }} value = bca_jr_best_score }
                check_variable_arithmetic = { which = bca_jr_fill_idx value = $SLOT_NUM$ }
            }
            bca_jr_fill_slot_job_stats = { SLOT_NAME = $SLOT_NAME$ JOB = {{ entry.job }} }
            add_variable = { which = bca_jr_fill_idx value = 1 }
        }
    {% endfor %}
    {% for number in display_numbers %}
        if = {
            limit = { NOT = { is_variable_set = bca_jr_slot_$SLOT_NAME$_{{ number }} } }
            set_variable = { which = bca_jr_slot_$SLOT_NAME$_{{ number }} value = 0 }
        }
    {% endfor %}
}

{# 排序填槽主逻辑 #}
bca_jr_refresh_slot_data = {
    optimize_memory
    set_variable = { which = bca_jr_fill_idx value = 1 }
    bca_jr_prepare_cached_sort_scores = yes

    {% for s in range(slots) %}
        {% set s_name = "s%d" % (s + 1) %}
        bca_jr_find_best_for_slot = yes
        if = {
            limit = {
                has_country_flag = bca_jr_has_best_score
            }
            bca_jr_fill_current_slot = { SLOT_NAME = {{ s_name }} SLOT_NUM = {{ s + 1 }} }
        }
    {% endfor %}

    set_variable = { which = bca_jr_display_count value = bca_jr_fill_idx }
    subtract_variable = { which = bca_jr_display_count value = 1 }
    bca_jr_clear_cached_sort_scores = yes
    clear_variable = bca_jr_fill_idx
    clear_variable = bca_jr_best_score
    remove_country_flag = bca_jr_has_best_score
}
