# submod job_regulation
{#
Phase 7: 岗位调控评估
1. 根据资源状态和 skip flag 发放 plan flag
2. 只统计被 plan 的岗位
3. 按统计结果发放 job_changes gear flag，并写回本月剩余额度
#}
{% set regulated = job_regulation_config.regulated_jobs %}
{% set economic_set = job_regulation_config.resources %}
{% set max_gear_step = job_regulation_config.gear_steps | max %}
{% set default_manual_manage_jobs = job_regulation_config.default_manual_manage_jobs | default([]) %}

{# ---- INC 分组 ---- #}
{% set inc_groups = {} %}
{% for entry in regulated %}
    {% for nc in entry.needs_categories %}
        {% set _ = inc_groups.setdefault(nc, []).append(entry) %}
    {% endfor %}
{% endfor %}

{# ---- DEC 分组：用 primary_needs 做外层资源过滤，完整 surplus 判断仍在 bca_jr_should_dec_x 中 ---- #}
{% set dec_groups = {} %}
{% for entry in regulated if entry.needs_categories and entry.pop_category and entry.primary_needs %}
    {% set _ = dec_groups.setdefault(entry.primary_needs, []).append(entry) %}
{% endfor %}

bca_jr_clear_monthly_job_changes = {
    optimize_memory
    {% for entry in regulated %}
        clear_variable = bca_jr_monthly_job_change_{{ entry.job }}
    {% endfor %}
}

bca_jr_clear_resource_remaining = {
    optimize_memory
    {% for need_name, need in economic_need_thresholds.items() if need_name in economic_set %}
        clear_variable = bca_jr_income_{{ need_name }}
        clear_variable = bca_jr_remaining_inc_{{ need_name }}
        clear_variable = bca_jr_remaining_dec_{{ need_name }}
    {% endfor %}
}

bca_jr_initialize_resource_remaining = {
    optimize_memory
    bca_global_settings_recompute_economic_target_bounds = yes
    {% for need_name, need in economic_need_thresholds.items() if need_name in economic_set %}
        clear_variable = bca_jr_income_{{ need_name }}
        clear_variable = bca_jr_remaining_inc_{{ need_name }}
        clear_variable = bca_jr_remaining_dec_{{ need_name }}
        export_resource_income_to_variable = { resource = {{ need.resource }} variable = bca_jr_income_{{ need_name }} }

        set_variable = { which = bca_jr_remaining_inc_{{ need_name }} value = bca_economic_target_lower_{{ need_name }} }
        subtract_variable = { which = bca_jr_remaining_inc_{{ need_name }} value = bca_jr_income_{{ need_name }} }
        if = {
            limit = { check_variable = { which = bca_jr_remaining_inc_{{ need_name }} value < 0 } }
            clear_variable = bca_jr_remaining_inc_{{ need_name }}
        }

        set_variable = { which = bca_jr_remaining_dec_{{ need_name }} value = bca_jr_income_{{ need_name }} }
        subtract_variable = { which = bca_jr_remaining_dec_{{ need_name }} value = bca_economic_target_upper_{{ need_name }} }
        if = {
            limit = { check_variable = { which = bca_jr_remaining_dec_{{ need_name }} value < 0 } }
            clear_variable = bca_jr_remaining_dec_{{ need_name }}
        }
    {% endfor %}
}

bca_jr_initialize_default_manual_manage_jobs = {
    if = {
        limit = { NOT = { has_country_flag = bca_jr_default_manual_manage_jobs_initialized } }
        set_country_flag = bca_jr_default_manual_manage_jobs_initialized
        {% for job in default_manual_manage_jobs %}
            set_country_flag = bca_jr_mode_manual_{{ job }}
            remove_country_flag = bca_jr_mode_empty_{{ job }}
            remove_country_flag = bca_jr_mode_full_{{ job }}
        {% endfor %}
    }
}

bca_jr_monthly_begin = {
    bca_jr_initialize_default_manual_manage_jobs = yes
    add_variable = { which = bca_jr_skip_refresh_counter value = 1 }
    if = {
        limit = { check_variable = { which = bca_jr_skip_refresh_counter value >= 6 } }
        every_owned_colony = {
            bca_jr_clear_skip_flags = yes
        }
        clear_variable = bca_jr_skip_refresh_counter
    }
    bca_jr_initialize_resource_remaining = yes
    bca_jr_clear_monthly_job_changes = yes
}

bca_jr_monthly_colony = {
    carrier_event = { id = colony_automation_event.2000 }
}

bca_jr_monthly_end = {
    bca_jr_clear_resource_remaining = yes
}

bca_jr_close_panel = {
    bca_jr_clear_slot_mapping = yes
    bca_jr_clear_country_job_totals = yes
    remove_country_flag = bca_jr_collect_country_totals
}

bca_jr_plan_inc_job = {
    optimize_memory
    if = {
        limit = {
            check_modifier_value = {
                modifier = job_$JOB$_add
                value > 0
            }
            bca_jr_should_inc_$JOB$_for_$NEED$ = yes
            owner = {
                is_variable_set = bca_jr_remaining_inc_$NEED$
                check_variable = { which = bca_jr_remaining_inc_$NEED$ value > 0 }
            }
            owner = {
                NOT = { has_country_flag = bca_jr_mode_manual_$JOB$ }
                NOT = { has_country_flag = bca_jr_mode_empty_$JOB$ }
                NOT = { has_country_flag = bca_jr_mode_full_$JOB$ }
            }
            NOT = { has_carrier_flag = bca_jr_skip_full_$JOB$ }
            NOT = { has_carrier_flag = bca_jr_plan_inc_$JOB$ }
        }
        set_carrier_flag = bca_jr_plan_inc_$JOB$
        remove_carrier_flag = bca_jr_plan_dec_$JOB$
    }
}

bca_jr_plan_dec_job = {
    optimize_memory
    if = {
        limit = {
            check_modifier_value = {
                modifier = job_$JOB$_add
                value > 0
            }
            NOT = { has_carrier_flag = bca_jr_plan_inc_$JOB$ }
            bca_jr_should_dec_$JOB$ = yes
            owner = {
                is_variable_set = bca_jr_remaining_dec_$NEED$
                check_variable = { which = bca_jr_remaining_dec_$NEED$ value > 0 }
            }
            owner = {
                NOT = { has_country_flag = bca_jr_mode_manual_$JOB$ }
                NOT = { has_country_flag = bca_jr_mode_empty_$JOB$ }
                NOT = { has_country_flag = bca_jr_mode_full_$JOB$ }
            }
            NOT = { has_carrier_flag = bca_jr_skip_empty_$JOB$ }
        }
        set_carrier_flag = bca_jr_plan_dec_$JOB$
    }
}

bca_jr_plan_job_checks = {
    optimize_memory
    # ==== INC: 任一需要资源命中即可计划增加 ====
    {% for nc, jobs in inc_groups.items() | sort %}
        if = {
            limit = { bca_empire_needs_{{ nc }} = yes }
            {% for entry in jobs %}
                bca_jr_plan_inc_job = { JOB = {{ entry.job }} NEED = {{ nc }} }
            {% endfor %}
        }
    {% endfor %}

    # ==== DEC: 所有有效产出都 surplus 才计划减少，且 INC 优先 ====
    {% for nc, jobs in dec_groups.items() | sort %}
        if = {
            limit = { bca_empire_has_surplus_{{ nc }} = yes }
            {% for entry in jobs %}
                bca_jr_plan_dec_job = { JOB = {{ entry.job }} NEED = {{ nc }} }
            {% endfor %}
        }
    {% endfor %}
}

bca_jr_prepare_inc_target = {
    optimize_memory
    set_variable = { which = bca_jr_target value = bca_jr_acc_total_job_count_$JOB$ }
    if = {
        limit = { is_variable_set = bca_jr_acc_closable_capacity_workforce_$JOB$ }
        subtract_variable = { which = bca_jr_target value = bca_jr_acc_closable_capacity_workforce_$JOB$ }
    }
    set_variable = { which = bca_jr_job_change_limit value = bca_jr_target }
}

bca_jr_limit_inc_target_for_resource = {
    optimize_memory
    if = {
        limit = {
            check_variable_arithmetic = { which = value:bca_job_$JOB$_$RESOURCE$_per_worker value > 0 }
            owner = {
                is_variable_set = bca_jr_remaining_inc_$RESOURCE$
                check_variable = { which = bca_jr_remaining_inc_$RESOURCE$ value > 0 }
            }
        }
        set_variable = { which = bca_jr_tmp_candidate value = owner.bca_jr_remaining_inc_$RESOURCE$ }
        divide_variable = { which = bca_jr_tmp_candidate value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
        if = {
            limit = {
                is_variable_set = bca_jr_acc_capacity_workforce_$JOB$
                check_variable_arithmetic = { which = bca_jr_acc_capacity_workforce_$JOB$ value > 0 }
            }
            divide_variable = { which = bca_jr_tmp_candidate value = bca_jr_acc_avg_output_efficiency_$JOB$ }
        }
        else = {
            divide_variable = { which = bca_jr_tmp_candidate value = value:bca_jr_automated_output_efficiency }
        }
        set_variable = {
            which = bca_jr_target
            value = value:bca_jr_min_value|LEFT|bca_jr_target|RIGHT|bca_jr_tmp_candidate|
        }
    }
}

bca_jr_apply_inc_target = {
    optimize_memory
    set_variable = { which = bca_jr_actual_job_change value = 0 }
    if = {
        limit = { check_variable_arithmetic = { which = bca_jr_target value <= 0 } }
        set_carrier_flag = bca_jr_skip_full_$JOB$
    }
    else = {
        remove_carrier_flag = bca_jr_skip_empty_$JOB$
        bca_jr_apply_inc_gears = { JOB = $JOB$ TARGET = bca_jr_target LIMIT = bca_jr_job_change_limit }
        if = {
            limit = { check_variable_arithmetic = { which = bca_jr_actual_job_change value > 0 } }
            owner = {
                add_variable = { which = bca_jr_monthly_job_change_$JOB$ value = prev.bca_jr_actual_job_change }
            }
        }
    }
}

bca_jr_writeback_inc_remaining_for_resource = {
    optimize_memory
    if = {
        limit = {
            check_variable_arithmetic = { which = bca_jr_actual_job_change value > 0 }
            check_variable_arithmetic = { which = value:bca_job_$JOB$_$RESOURCE$_per_worker value > 0 }
        }
        set_variable = { which = bca_jr_tmp_resource_delta value = bca_jr_actual_job_change }
        if = {
            limit = {
                is_variable_set = bca_jr_acc_capacity_workforce_$JOB$
                check_variable_arithmetic = { which = bca_jr_acc_capacity_workforce_$JOB$ value > 0 }
            }
            multiply_variable = { which = bca_jr_tmp_resource_delta value = bca_jr_acc_avg_output_efficiency_$JOB$ }
        }
        else = {
            multiply_variable = { which = bca_jr_tmp_resource_delta value = value:bca_jr_automated_output_efficiency }
        }
        multiply_variable = { which = bca_jr_tmp_resource_delta value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
        owner = {
            subtract_variable = { which = bca_jr_remaining_inc_$RESOURCE$ value = prev.bca_jr_tmp_resource_delta }
            if = {
                limit = { check_variable = { which = bca_jr_remaining_inc_$RESOURCE$ value < 0 } }
                clear_variable = bca_jr_remaining_inc_$RESOURCE$
            }
        }
    }
}

bca_jr_prepare_dec_target = {
    optimize_memory
    set_variable = { which = bca_jr_target value = 0 }
    if = {
        limit = { is_variable_set = bca_jr_acc_closable_capacity_workforce_$JOB$ }
        set_variable = { which = bca_jr_target value = bca_jr_acc_closable_capacity_workforce_$JOB$ }
    }
    set_variable = { which = bca_jr_job_change_limit value = bca_jr_target }
}

bca_jr_limit_dec_target_for_resource = {
    optimize_memory
    if = {
        limit = {
            check_variable_arithmetic = { which = value:bca_job_$JOB$_$RESOURCE$_per_worker value > 0 }
            owner = {
                is_variable_set = bca_jr_remaining_dec_$RESOURCE$
                check_variable = { which = bca_jr_remaining_dec_$RESOURCE$ value > 0 }
            }
        }
        set_variable = { which = bca_jr_tmp_candidate value = owner.bca_jr_remaining_dec_$RESOURCE$ }
        set_variable = { which = bca_jr_tmp_pop_output value = 0 }
        if = {
            limit = { is_variable_set = bca_jr_acc_pop_productive_workforce_$JOB$ }
            set_variable = { which = bca_jr_tmp_pop_output value = bca_jr_acc_pop_productive_workforce_$JOB$ }
        }
        multiply_variable = { which = bca_jr_tmp_pop_output value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
        if = {
            limit = {
                is_variable_set = bca_jr_acc_capacity_workforce_$JOB$
                check_variable_arithmetic = { which = bca_jr_acc_capacity_workforce_$JOB$ value > 0 }
                check_variable_arithmetic = { which = bca_jr_tmp_candidate value <= bca_jr_tmp_pop_output }
            }
            divide_variable = { which = bca_jr_tmp_candidate value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
            divide_variable = { which = bca_jr_tmp_candidate value = bca_jr_acc_avg_output_efficiency_$JOB$ }
            add_variable = { which = bca_jr_tmp_candidate value = bca_jr_acc_free_job_count_$JOB$ }
        }
        else = {
            subtract_variable = { which = bca_jr_tmp_candidate value = bca_jr_tmp_pop_output }
            if = {
                limit = { check_variable = { which = bca_jr_tmp_candidate value < 0 } }
                clear_variable = bca_jr_tmp_candidate
            }
            divide_variable = { which = bca_jr_tmp_candidate value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
            divide_variable = { which = bca_jr_tmp_candidate value = value:bca_jr_automated_output_efficiency }
            add_variable = { which = bca_jr_tmp_candidate value = bca_jr_acc_free_job_count_$JOB$ }
            if = {
                limit = { is_variable_set = bca_jr_acc_capacity_workforce_$JOB$ }
                add_variable = { which = bca_jr_tmp_candidate value = bca_jr_acc_capacity_workforce_$JOB$ }
            }
        }
        set_variable = {
            which = bca_jr_target
            value = value:bca_jr_min_value|LEFT|bca_jr_target|RIGHT|bca_jr_tmp_candidate|
        }
    }
}

bca_jr_apply_dec_target = {
    optimize_memory
    set_variable = { which = bca_jr_actual_job_change value = 0 }
    if = {
        limit = { check_variable_arithmetic = { which = bca_jr_target value <= 0 } }
        set_carrier_flag = bca_jr_skip_empty_$JOB$
    }
    else = {
        remove_carrier_flag = bca_jr_skip_full_$JOB$
        bca_jr_apply_dec_gears = { JOB = $JOB$ TARGET = bca_jr_target LIMIT = bca_jr_job_change_limit }
        if = {
            limit = { check_variable_arithmetic = { which = bca_jr_actual_job_change value > 0 } }
            owner = {
                subtract_variable = { which = bca_jr_monthly_job_change_$JOB$ value = prev.bca_jr_actual_job_change }
            }
        }

        set_variable = { which = bca_jr_tmp_remaining_capacity_delta value = bca_jr_actual_job_change }
        subtract_variable = { which = bca_jr_tmp_remaining_capacity_delta value = bca_jr_acc_free_job_count_$JOB$ }
        if = {
            limit = { check_variable = { which = bca_jr_tmp_remaining_capacity_delta value < 0 } }
            set_variable = { which = bca_jr_tmp_remaining_capacity_delta value = 0 }
        }

        set_variable = { which = bca_jr_tmp_assigned_delta value = 0 }
        if = {
            limit = {
                is_variable_set = bca_jr_acc_capacity_workforce_$JOB$
                check_variable_arithmetic = { which = bca_jr_tmp_remaining_capacity_delta value > 0 }
            }
            set_variable = { which = bca_jr_tmp_assigned_delta value = bca_jr_tmp_remaining_capacity_delta }
            if = {
                limit = { check_variable_arithmetic = { which = bca_jr_tmp_assigned_delta value > bca_jr_acc_capacity_workforce_$JOB$ } }
                set_variable = { which = bca_jr_tmp_assigned_delta value = bca_jr_acc_capacity_workforce_$JOB$ }
            }
        }

        set_variable = { which = bca_jr_tmp_automated_delta value = bca_jr_tmp_remaining_capacity_delta }
        if = {
            limit = { is_variable_set = bca_jr_acc_capacity_workforce_$JOB$ }
            subtract_variable = { which = bca_jr_tmp_automated_delta value = bca_jr_acc_capacity_workforce_$JOB$ }
        }
        if = {
            limit = { check_variable = { which = bca_jr_tmp_automated_delta value < 0 } }
            set_variable = { which = bca_jr_tmp_automated_delta value = 0 }
        }
    }
}

bca_jr_writeback_dec_pop_remaining_for_resource = {
    optimize_memory
    if = {
        limit = {
            is_variable_set = bca_jr_tmp_assigned_delta
            check_variable_arithmetic = { which = bca_jr_tmp_assigned_delta value > 0 }
            check_variable_arithmetic = { which = value:bca_job_$JOB$_$RESOURCE$_per_worker value > 0 }
        }
        set_variable = { which = bca_jr_tmp_resource_delta value = bca_jr_tmp_assigned_delta }
        multiply_variable = { which = bca_jr_tmp_resource_delta value = bca_jr_acc_avg_output_efficiency_$JOB$ }
        multiply_variable = { which = bca_jr_tmp_resource_delta value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
        owner = {
            subtract_variable = { which = bca_jr_remaining_dec_$RESOURCE$ value = prev.bca_jr_tmp_resource_delta }
            if = {
                limit = { check_variable = { which = bca_jr_remaining_dec_$RESOURCE$ value < 0 } }
                clear_variable = bca_jr_remaining_dec_$RESOURCE$
            }
        }
    }
}

bca_jr_writeback_dec_automated_remaining_for_resource = {
    optimize_memory
    if = {
        limit = {
            is_variable_set = bca_jr_tmp_automated_delta
            check_variable_arithmetic = { which = bca_jr_tmp_automated_delta value > 0 }
            check_variable_arithmetic = { which = value:bca_job_$JOB$_$RESOURCE$_per_worker value > 0 }
        }
        set_variable = { which = bca_jr_tmp_resource_delta value = bca_jr_tmp_automated_delta }
        multiply_variable = { which = bca_jr_tmp_resource_delta value = value:bca_jr_automated_output_efficiency }
        multiply_variable = { which = bca_jr_tmp_resource_delta value = value:bca_job_$JOB$_$RESOURCE$_per_worker }
        owner = {
            subtract_variable = { which = bca_jr_remaining_dec_$RESOURCE$ value = prev.bca_jr_tmp_resource_delta }
            if = {
                limit = { check_variable = { which = bca_jr_remaining_dec_$RESOURCE$ value < 0 } }
                clear_variable = bca_jr_remaining_dec_$RESOURCE$
            }
        }
    }
}

bca_jr_force_empty_job = {
    optimize_memory
    set_variable = { which = bca_jr_actual_job_change value = 0 }
    if = {
        limit = {
            check_modifier_value = {
                modifier = job_$JOB$_add
                value > 0
            }
            NOT = { has_carrier_flag = bca_jr_skip_empty_$JOB$ }
        }
        remove_carrier_flag = bca_jr_skip_full_$JOB$
        set_carrier_flag = bca_jr_dec_$JOB$_g{{ max_gear_step }}
        if = {
            limit = { is_variable_set = bca_jr_acc_closable_capacity_workforce_$JOB$ }
            set_variable = {
                which = bca_jr_actual_job_change
                value = value:bca_jr_min_value|LEFT|{{ max_gear_step }}|RIGHT|bca_jr_acc_closable_capacity_workforce_$JOB$|
            }
            owner = {
                subtract_variable = { which = bca_jr_monthly_job_change_$JOB$ value = prev.bca_jr_actual_job_change }
            }
        }
    }
}

bca_jr_force_full_job = {
    optimize_memory
    set_variable = { which = bca_jr_actual_job_change value = 0 }
    if = {
        limit = {
            check_modifier_value = {
                modifier = job_$JOB$_add
                value > 0
            }
            NOT = { has_carrier_flag = bca_jr_skip_full_$JOB$ }
        }
        remove_carrier_flag = bca_jr_skip_empty_$JOB$
        set_carrier_flag = bca_jr_inc_$JOB$_g{{ max_gear_step }}
        set_variable = { which = bca_jr_actual_job_change value = bca_jr_acc_total_job_count_$JOB$ }
        if = {
            limit = { is_variable_set = bca_jr_acc_closable_capacity_workforce_$JOB$ }
            subtract_variable = { which = bca_jr_actual_job_change value = bca_jr_acc_closable_capacity_workforce_$JOB$ }
        }
        set_variable = {
            which = bca_jr_actual_job_change
            value = value:bca_jr_min_value|LEFT|{{ max_gear_step }}|RIGHT|bca_jr_actual_job_change|
        }
        owner = {
            add_variable = { which = bca_jr_monthly_job_change_$JOB$ value = prev.bca_jr_actual_job_change }
        }
    }
}

bca_jr_apply_planned_job_changes = {
    optimize_memory
    {% for entry in regulated if entry.pop_category %}
        if = {
            limit = { owner = { has_country_flag = bca_jr_mode_empty_{{ entry.job }} } }
            bca_jr_force_empty_job = { JOB = {{ entry.job }} }
        }
        else_if = {
            limit = { owner = { has_country_flag = bca_jr_mode_full_{{ entry.job }} } }
            bca_jr_force_full_job = { JOB = {{ entry.job }} }
        }
        else_if = {
            limit = {
                owner = {
                    has_country_flag = bca_jr_mode_manual_{{ entry.job }}
                }
            }
        }
        else = {
            if = {
                limit = { has_carrier_flag = bca_jr_plan_inc_{{ entry.job }} }
                bca_jr_prepare_inc_target = { JOB = {{ entry.job }} }
                {% for resource in entry.economic_resources if resource in economic_set %}
                    bca_jr_limit_inc_target_for_resource = { JOB = {{ entry.job }} RESOURCE = {{ resource }} }
                {% endfor %}
                bca_jr_apply_inc_target = { JOB = {{ entry.job }} }
                {% for resource in entry.economic_resources if resource in economic_set %}
                    bca_jr_writeback_inc_remaining_for_resource = { JOB = {{ entry.job }} RESOURCE = {{ resource }} }
                {% endfor %}
            }
            if = {
                limit = { has_carrier_flag = bca_jr_plan_dec_{{ entry.job }} }
                bca_jr_prepare_dec_target = { JOB = {{ entry.job }} }
                {% for resource in entry.economic_resources if resource in economic_set %}
                    bca_jr_limit_dec_target_for_resource = { JOB = {{ entry.job }} RESOURCE = {{ resource }} }
                {% endfor %}
                bca_jr_apply_dec_target = { JOB = {{ entry.job }} }
                {% for resource in entry.economic_resources if resource in economic_set %}
                    bca_jr_writeback_dec_pop_remaining_for_resource = { JOB = {{ entry.job }} RESOURCE = {{ resource }} }
                    bca_jr_writeback_dec_automated_remaining_for_resource = { JOB = {{ entry.job }} RESOURCE = {{ resource }} }
                {% endfor %}
            }
        }
    {% endfor %}

    clear_variable = bca_jr_target
    clear_variable = bca_jr_job_change_limit
    clear_variable = bca_jr_tmp_candidate
    clear_variable = bca_jr_tmp_resource_delta
    clear_variable = bca_jr_tmp_assigned_delta
    clear_variable = bca_jr_tmp_automated_delta
    clear_variable = bca_jr_tmp_remaining_capacity_delta
    clear_variable = bca_jr_tmp_pop_output
    clear_variable = bca_jr_actual_job_change
}

bca_jr_evaluate_all = {
    optimize_memory
    bca_jr_plan_job_checks = yes
    bca_jr_clear_accumulators = yes
    bca_jr_collect_checked_job_stats = yes
    bca_jr_finalize_job_stats = yes
    bca_jr_apply_planned_job_changes = yes
    bca_jr_clear_transient_flags = yes
    bca_jr_clear_accumulators = yes
}
