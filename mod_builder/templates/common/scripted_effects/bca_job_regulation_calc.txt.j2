{# Phase 7: 岗位统计。统计本身是纯操作，控制器通过临时 check flag 决定要统计哪些岗位。 #}
{% set regulated = job_regulation_config.regulated_jobs %}

{# ---- 清零所有累加器 ---- #}
bca_jr_clear_accumulators = {
    clear_variable = bca_jr_v_size
    clear_variable = bca_jr_v_capacity
    clear_variable = bca_jr_v_productive
    clear_variable = bca_jr_tmp_job_count
    clear_variable = bca_jr_tmp_free_job_count
{% for entry in regulated %}
    clear_variable = bca_jr_acc_assigned_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_capacity_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_pop_productive_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_productive_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_automated_capacity_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_automated_productive_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_pop_capacity_limit_{{ entry.job }}
    clear_variable = bca_jr_acc_total_job_count_{{ entry.job }}
    clear_variable = bca_jr_acc_free_job_count_{{ entry.job }}
    clear_variable = bca_jr_acc_open_job_count_{{ entry.job }}
    clear_variable = bca_jr_acc_closable_capacity_workforce_{{ entry.job }}
    clear_variable = bca_jr_acc_avg_output_efficiency_{{ entry.job }}
{% for resource in entry.economic_resources %}
    clear_variable = bca_jr_acc_output_{{ entry.job }}_{{ resource }}
{% endfor %}
{% endfor %}
}

{# ---- 统计被 check flag 选中的岗位 ---- #}
bca_jr_collect_job_count_stats = {
    optimize_memory
    set_variable = {
        which = bca_jr_acc_total_job_count_$JOB$
        value = modifier:job_$JOB$_add
    }
    export_trigger_value_to_variable = {
        trigger = free_jobs_of_type
        parameters = { job = $JOB$ }
        variable = bca_jr_acc_free_job_count_$JOB$
    }
}

bca_jr_collect_current_pop_group_stats = {
    optimize_memory
    set_variable = {
        which = bca_jr_v_size
        value = value:bca_jr_num_pops_assigned_to_job|JOB|event_target:bca_jr_current_pop_job|POP_GROUP|event_target:bca_jr_current_pop_group|
    }
    if = {
        limit = {
            check_variable_arithmetic = { which = bca_jr_v_size value > 0 }
        }
        set_variable = {
            which = bca_jr_v_capacity
            value = bca_jr_v_size
        }
        multiply_variable = {
            which = bca_jr_v_capacity
            value = value:bca_jr_workforce_capacity_mult_$JOB$
        }
        set_variable = {
            which = bca_jr_v_productive
            value = bca_jr_v_capacity
        }
        multiply_variable = {
            which = bca_jr_v_productive
            value = value:bca_jr_output_efficiency_mult_$JOB$
        }

        add_variable = {
            which = bca_jr_acc_assigned_workforce_$JOB$
            value = bca_jr_v_size
        }
        add_variable = {
            which = bca_jr_acc_capacity_workforce_$JOB$
            value = bca_jr_v_capacity
        }
        add_variable = {
            which = bca_jr_acc_pop_productive_workforce_$JOB$
            value = bca_jr_v_productive
        }
        add_variable = {
            which = bca_jr_acc_productive_workforce_$JOB$
            value = bca_jr_v_productive
        }
    }
    clear_variable = bca_jr_v_size
    clear_variable = bca_jr_v_capacity
    clear_variable = bca_jr_v_productive
}

bca_jr_collect_checked_job_stats = {
    optimize_memory
{% for entry in regulated if entry.pop_category %}
    if = {
        limit = {
            OR = {
                has_carrier_flag = bca_jr_check_all_jobs
                has_carrier_flag = bca_jr_plan_inc_{{ entry.job }}
                has_carrier_flag = bca_jr_plan_dec_{{ entry.job }}
            }
            check_modifier_value = {
                modifier = job_{{ entry.job }}_add
                value > 0
            }
        }
        bca_jr_collect_job_count_stats = { JOB = {{ entry.job }} }
    }
{% endfor %}

    every_owned_pop_job = {
{% for entry in regulated if entry.pop_category %}
        if = {
            limit = {
                has_job_type = {{ entry.job }}
                prev = {
                    OR = {
                        has_carrier_flag = bca_jr_check_all_jobs
                        has_carrier_flag = bca_jr_plan_inc_{{ entry.job }}
                        has_carrier_flag = bca_jr_plan_dec_{{ entry.job }}
                    }
                }
            }
            every_job_pop_group = {
                save_event_target_as = bca_jr_current_pop_group
                prev = { save_event_target_as = bca_jr_current_pop_job }
                colony = {
                    bca_jr_collect_current_pop_group_stats = { JOB = {{ entry.job }} }
                }
            }
        }
{% endfor %}
    }
    clear_variable = bca_jr_tmp_job_count
}

{# ---- 派生统计量：开放岗位数量与平均产出效率 ---- #}
bca_jr_finalize_single_job_stats = {
    optimize_memory
    set_variable = {
        which = bca_jr_acc_automated_capacity_workforce_$JOB$
        value = bca_jr_acc_total_job_count_$JOB$
    }
    multiply_variable = {
        which = bca_jr_acc_automated_capacity_workforce_$JOB$
        value = modifier:job_$JOB$_automated_workforce_mult
    }
    if = {
        limit = {
            check_variable_arithmetic = { which = bca_jr_acc_automated_capacity_workforce_$JOB$ value > bca_jr_acc_total_job_count_$JOB$ }
        }
        set_variable = {
            which = bca_jr_acc_automated_capacity_workforce_$JOB$
            value = bca_jr_acc_total_job_count_$JOB$
        }
    }
    set_variable = {
        which = bca_jr_acc_automated_productive_workforce_$JOB$
        value = bca_jr_acc_automated_capacity_workforce_$JOB$
    }
    multiply_variable = {
        which = bca_jr_acc_automated_productive_workforce_$JOB$
        value = value:bca_jr_automated_output_efficiency
    }
    add_variable = {
        which = bca_jr_acc_productive_workforce_$JOB$
        value = bca_jr_acc_automated_productive_workforce_$JOB$
    }
    set_variable = {
        which = bca_jr_acc_pop_capacity_limit_$JOB$
        value = bca_jr_acc_total_job_count_$JOB$
    }
    subtract_variable = {
        which = bca_jr_acc_pop_capacity_limit_$JOB$
        value = bca_jr_acc_automated_capacity_workforce_$JOB$
    }
    if = {
        limit = {
            check_variable_arithmetic = { which = bca_jr_acc_pop_capacity_limit_$JOB$ value < 0 }
        }
        clear_variable = bca_jr_acc_pop_capacity_limit_$JOB$
    }
    set_variable = {
        which = bca_jr_acc_open_job_count_$JOB$
        value = bca_jr_acc_capacity_workforce_$JOB$
    }
    add_variable = {
        which = bca_jr_acc_open_job_count_$JOB$
        value = bca_jr_acc_free_job_count_$JOB$
    }
    set_variable = {
        which = bca_jr_acc_closable_capacity_workforce_$JOB$
        value = bca_jr_acc_open_job_count_$JOB$
    }
    add_variable = {
        which = bca_jr_acc_closable_capacity_workforce_$JOB$
        value = bca_jr_acc_automated_capacity_workforce_$JOB$
    }
    if = {
        limit = {
            check_variable_arithmetic = { which = bca_jr_acc_closable_capacity_workforce_$JOB$ value > bca_jr_acc_total_job_count_$JOB$ }
        }
        set_variable = {
            which = bca_jr_acc_closable_capacity_workforce_$JOB$
            value = bca_jr_acc_total_job_count_$JOB$
        }
    }
    if = {
        limit = {
            check_variable_arithmetic = { which = bca_jr_acc_capacity_workforce_$JOB$ value > 0 }
        }
        set_variable = {
            which = bca_jr_acc_avg_output_efficiency_$JOB$
            value = bca_jr_acc_pop_productive_workforce_$JOB$
        }
        divide_variable = {
            which = bca_jr_acc_avg_output_efficiency_$JOB$
            value = bca_jr_acc_capacity_workforce_$JOB$
        }
    }
    else = {
        set_variable = { which = bca_jr_acc_avg_output_efficiency_$JOB$ value = 1 }
    }
}

bca_jr_finalize_job_stats = {
    optimize_memory
{% for entry in regulated if entry.pop_category %}
    bca_jr_finalize_single_job_stats = { JOB = {{ entry.job }} }
{% for resource in entry.economic_resources %}
    set_variable = {
        which = bca_jr_acc_output_{{ entry.job }}_{{ resource }}
        value = bca_jr_acc_productive_workforce_{{ entry.job }}
    }
    multiply_variable = {
        which = bca_jr_acc_output_{{ entry.job }}_{{ resource }}
        value = value:bca_job_{{ entry.job }}_{{ resource }}_per_worker
    }
{% endfor %}
{% endfor %}
}
