{% import 'component/planet_flag_ps.j2' as pf with context %}
{% import 'component/planet_variable.j2' as v with context %}
{% import 'component/conditions.j2' as cond with context %}
{% import 'component/zone_setting_option_operation.j2' as op with context -%}

{% set resource_boost_builds = {
        'energy': ['building_energy_grid', 'building_energy_nexus'],
        'minerals': ['building_mineral_purification_plant', 'building_mineral_purification_hub'],
        'food': ['building_food_processing_facility', 'building_food_processing_center']
    } %}

{% macro boost_building(resource) -%}
    {% set b1 = resource_boost_builds[resource][0] %}
    {% set b2 = resource_boost_builds[resource][1] %}

    {% set index = 5 %}
    {% set priority_shift = 'bca_non_job_provider_priority_shift' %}

    {% set b1_cost = "b1_time" %}
    {% set b1_inc_job = 0 %}
    {% set b1_inc_add = "value:bca_production_add_" ~ resource ~ "_" ~ b1 %}
    {% set b1_inc_mult = 0 %}

    {% set b2_cost = "b2_time" %}
    {% set b2_inc_job = 0 %}
    {% set b2_inc_add = "value:bca_production_add_" ~ resource ~ "_" ~ b2 %}
    {% set b2_inc_mult = 0 %}
    {% set standard_production = "bca_potential_standard_" ~ resource ~ "_production" %}

    if = {
        limit = {
            NOR = {
                has_building = {{ b1 }}
                has_building = {{ b2 }}
            }
        }

        try_construct_building = {
            building = {{ b1 }}
            standard_production = {{ standard_production }}
            INC_JOB = {{ b1_inc_job }}
            INC_ADD = {{ b1_inc_add }}
            INC_MULT = {{ b1_inc_mult }}
            cost = @[{{ b1_cost }}]
            priority_shift = {{ priority_shift }}
            index = {{ index }}
        }
        # long-term planing compute for b2 but build b1
        try_construct_building = {
            building = {{ b1 }}
            standard_production = {{ standard_production }}
            INC_JOB = {{ b2_inc_job }}
            INC_ADD = {{ b2_inc_add }}
            INC_MULT = {{ b2_inc_mult }}
            cost = @[{{ b1_cost }} + {{ b2_cost }}]
            priority_shift = {{ priority_shift }}
            index = {{ index }}
        }
    }
{%- endmacro %}

{% macro construction_list(resource,zone_type_set) -%}


    if = {
        limit = {
            requires_more_job = yes
        }
        {% for zone_slot in ['z3','z4','z5'] %}
            {% set district_slot = zone_slot_district_slot_mapping[zone_slot] %}
            {{ "if" if loop.first else "else_if" }} = {
                limit = {
                    OR = {
                        {% for zone_type in zone_type_set %}
                            has_carrier_flag = {{ pf.flag_selected_zone_type(zone_slot, zone_type) }}
                        {% endfor %}
                    }
                }
        {# secondary zone #}
                {% for zone_type in zone_type_set %}
                    if = {
                        limit = {
                            has_carrier_flag = {{ pf.flag_selected_zone_type(zone_slot, zone_type) }}
                            check_variable_arithmetic = {
                                which = value:num_secondary_zones_of_type_{{ zone_type }}
                                value < value:num_secondary_zone_plan_of_type_{{ zone_type }}
                            }
                        }
                        set_carrier_flag = {{ pf.flag_plan_build_secondary_zone_type(zone_type) }}
                    }
                {% endfor %}
        {# secondary district #}
                if = {
                    limit = {
                        NOT = { has_carrier_flag = bca_pf_disable_auto_district_manage }
                    }
                    set_variable = {
                        which = {{v.var_district_num_plan(zone_slot)}}
                        value = bca_opti_count_secondary_district
                    }
                }
                try_construct_district = {
                    district_slot = {{ district_slot }}
                    district_max = bca_opti_count_secondary_district
                    production = value:bca_potential_standard_{{ resource }}_production
                    cost = 240
                    priority_shift = 0
                    index = 1
                }
            }
        {% endfor %}
    }

    try_construct_district = {
        district_slot = d0
        district_max = bca_opti_count_primary_district
        production = value:bca_potential_standard_{{ resource }}_production
        cost = 480
        priority_shift = bca_non_job_provider_priority_shift
        index = 2
    }

    try_construct_zone_city = {
        zone = zone_urban_{{ resource }}
        zone_type = {{ zone_type_set[0] }}
        production = value:bca_potential_standard_{{ resource }}_production|INC_MULT|value:bca_production_inc_mult_from_urban_resource|
        cost = @zone_buildtime
        priority_shift = bca_non_job_provider_priority_shift
        index = 4
    }

    {{ boost_building(resource) }}

{%- endmacro %}


