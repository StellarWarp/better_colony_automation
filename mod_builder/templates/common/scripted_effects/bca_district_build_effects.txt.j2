{% import 'component/planet_flag_ps.j2' as pf with context %}
{% import 'component/planet_variable.j2' as v with context %}

{% macro output_condition(conditions) -%}
    {% set conditional = conditions | reject('equalto', none) | list %}
    {% set has_unconditional = conditions | select('equalto', none) | list | length > 0 %}
    {% if conditional and not has_unconditional %}
        {% if conditional|length == 1 %}
            AND = {
                {{ conditional[0] | replace('\n', '\n        ') }}
            }
        {% else %}
            OR = {
                {% for condition in conditional %}
                    AND = {
                        {{ condition | replace('\n', '\n            ') }}
                    }
                {% endfor %}
            }
        {% endif %}
    {% endif %}
{%- endmacro %}

{% macro resource_need(output, conditions) -%}
    {% set conditional = conditions | reject('equalto', none) | list %}
    {% set has_unconditional = conditions | select('equalto', none) | list | length > 0 %}
    {% if conditional and not has_unconditional %}
        AND = {
            bca_empire_needs_{{ output }} = yes
            {{ output_condition(conditions) }}
        }
    {% else %}
        bca_empire_needs_{{ output }} = yes
    {% endif %}
{%- endmacro %}

{% macro resource_gate(outputs, resource_conditions) -%}
    {% if outputs %}
        {% if outputs|length == 1 %}
            {{ resource_need(outputs[0], resource_conditions.get(outputs[0], [])) }}
        {% else %}
            OR = {
                {% for output in outputs %}
                    {{ resource_need(output, resource_conditions.get(output, [])) }}
                {% endfor %}
            }
        {% endif %}
    {% endif %}
{%- endmacro %}

{% macro zone_output_gate(zone, outputs, resource_conditions, zone_slots) -%}
    AND = {
        {% if zone_slots|length == 1 %}
            has_carrier_flag = {{ pf.flag_selected_zone(zone_slots[0], zone) }}
        {% else %}
            OR = {
                {% for zone_slot in zone_slots %}
                    has_carrier_flag = {{ pf.flag_selected_zone(zone_slot, zone) }}
                {% endfor %}
            }
        {% endif %}
        {{ resource_gate(outputs, resource_conditions) }}
    }
{%- endmacro %}

{% macro district_slot_economic_allowed(slot_key, zone_slots) -%}
    {% set zone_outputs = economic_district_slot_zone_outputs.get(slot_key, {}) %}
    {% set zone_output_conditions = economic_district_slot_zone_output_conditions.get(slot_key, {}) %}
    {% if zone_outputs %}
        OR = {
            {% for zone, outputs in zone_outputs.items() %}
                {{ zone_output_gate(zone, outputs, zone_output_conditions.get(zone, {}), zone_slots) }}
            {% endfor %}
        }
    {% endif %}
{%- endmacro %}

{% macro try_build_district(index) -%}
    {% if index == 0 %}
        if = {
            limit = {
                check_variable_arithmetic = {
                    which = value:bca_num_primary_districts_plan
                    value > value:num_primary_district
                }
                {{ district_slot_economic_allowed('d0', ['z1', 'z2']) }}
            }
            set_carrier_flag = {{ pf.flag_district_plan_build('d0') }}
        }
    {% else %}
        {% set district_slot = ['d1','d2','d3'][index - 1] %}
        {% set zone_slot = ['z3','z4','z5'][index - 1] %}
        if = {
            limit = {
                check_variable = {
                    which = {{ v.var_district_num_plan(zone_slot) }}
                    value > value:num_district_{{ district_slot }}
                }
                {{ district_slot_economic_allowed(district_slot, [zone_slot]) }}
            }
            set_carrier_flag = {{ pf.flag_district_plan_build(district_slot) }}
        }
    {% endif %}
{%- endmacro %}

{% for i in range(4) %}
    bca_try_build_district_{{ i }} = {
        optimize_memory
        {{ try_build_district(i) }}
    }

{% endfor %}
