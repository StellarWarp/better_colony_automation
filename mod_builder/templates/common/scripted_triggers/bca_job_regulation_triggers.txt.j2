# submod job_regulation
{#
岗位调控辅助触发器
判断某岗位的某个产出是否在当前星球上激活（考虑条件 trigger）
#}
{% set regulated = job_regulation_config.regulated_jobs %}
{% set economic_set = job_regulation_config.resources %}

{% for resource in economic_set %}
bca_jr_resource_{{ resource }}_participates = {
    NOT = { has_country_flag = bca_economic_target_{{ resource }}_forbidden }
}

{% endfor %}
bca_jr_is_enabled = {
    has_country_flag = bca_jr_enabled
    has_country_flag = bca_enable_economic_management
}

bca_jr_should_collect_job_stats = {
    OR = {
        AND = {
            check_modifier_value = {
                modifier = job_$JOB$_add
                value > 0
            }
            OR = {
                has_carrier_flag = bca_jr_check_all_jobs
                has_carrier_flag = bca_jr_plan_inc_$JOB$
                has_carrier_flag = bca_jr_plan_dec_$JOB$
                owner = {
                    OR = {
                        has_country_flag = bca_jr_mode_empty_$JOB$
                        has_country_flag = bca_jr_mode_full_$JOB$
                    }
                }
            }
        }
        AND = {
            has_carrier_flag = bca_jr_check_all_jobs
            owner = { has_country_flag = bca_jr_collect_country_totals }
        }
    }
}

bca_jr_job_has_display_stats = {
    OR = {
        is_variable_set = bca_jr_total_job_count_$JOB$
        is_variable_set = bca_jr_total_productive_workforce_$JOB$
    }
}

bca_jr_job_matches_selected_filters = {
    OR = {
        has_country_flag = bca_jr_filter_all
        {% for resource in economic_set %}
            AND = {
                has_country_flag = bca_jr_filter_{{ resource }}
                is_variable_set = bca_jr_total_output_$JOB$_{{ resource }}
                check_variable = { which = bca_jr_total_output_$JOB$_{{ resource }} value > 0 }
            }
        {% endfor %}
        AND = {
            has_country_flag = bca_jr_filter_other
            NOR = {
                {% for resource in economic_set %}
                    AND = {
                        is_variable_set = bca_jr_total_output_$JOB$_{{ resource }}
                        check_variable = { which = bca_jr_total_output_$JOB$_{{ resource }} value > 0 }
                    }
                {% endfor %}
            }
        }
    }
}

{% for entry in regulated %}
    {% for resource in economic_set %}
        {% if resource in entry.economic_resources %}
            {% set all_produces = entry.produces | selectattr('resource', 'equalto', resource) | list %}
            {% set has_unconditional = all_produces | selectattr('trigger', 'equalto', none) | list | length > 0 %}
            {% set cond_produces = all_produces | selectattr('trigger') | list %}
            {% if not has_unconditional and cond_produces %}
                # {{ entry.job }} → {{ resource }} 全部产出均有条件，需满足任一 trigger
                bca_jr_has_output_{{ entry.job }}_{{ resource }} = {
                    OR = {
                        {% for prod in cond_produces %}
                            AND = {
                                {{ prod.trigger | replace('\n', '\n            ') }}
                            }
                        {% endfor %}
                    }
                }
            {% else %}
                # {{ entry.job }} → {{ resource }} 有无条件产出（base）或全部无条件
                bca_jr_has_output_{{ entry.job }}_{{ resource }} = {
                    always = yes
                }
            {% endif %}
        {% else %}
            # {{ entry.job }} → {{ resource }} 无已知产出
            bca_jr_has_output_{{ entry.job }}_{{ resource }} = {
                always = no
            }
        {% endif %}

    {% endfor %}

    {# INC 条件: 该岗位在 needs_category 组中是否实际产出对应资源 #}
    {% for nc in entry.needs_categories %}
        bca_jr_should_inc_{{ entry.job }}_for_{{ nc }} = {
            {% set nc_resources = entry.economic_resources | select('equalto', nc) | list %}
            {% if nc_resources %}
                OR = {
                    {% for res in nc_resources %}
                        bca_jr_has_output_{{ entry.job }}_{{ res }} = yes
                    {% endfor %}
                }
            {% else %}
                always = yes
            {% endif %}
        }

    {% endfor %}
    {# DEC 条件: 至少一个参与资源 surplus，且所有参与资源均 surplus。Forbidden 资源退出决策。 #}
    bca_jr_should_dec_{{ entry.job }} = {
        # 至少一个实际盈余产出驱动减岗；surplus 本身已排除 forbidden。
        OR = {
            {% for resource in entry.economic_resources if resource in economic_set %}
                AND = {
                    bca_jr_has_output_{{ entry.job }}_{{ resource }} = yes
                    bca_empire_has_surplus_{{ resource }} = yes
                }
            {% endfor %}
        }
        # 实际产出参与调控时，必须处于盈余。
        {% for resource in entry.economic_resources if resource in economic_set %}
            if = {
                limit = {
                    bca_jr_has_output_{{ entry.job }}_{{ resource }} = yes
                    owner = { bca_jr_resource_{{ resource }}_participates = yes }
                }
                bca_empire_has_surplus_{{ resource }} = yes
            }
        {% endfor %}
    }

{% endfor %}
