{# 赤字守卫：基础/稀有资源赤字时暂停自动建造，除非建造目标正好产出该赤字资源（2026-10-19 玩家反馈 #4/#5 修复） #}
bca_country_has_basic_deficit = {
    OR = {
        has_deficit = energy
        has_deficit = food
        has_deficit = minerals
        has_deficit = consumer_goods
        has_deficit = alloys
        has_deficit = rare_crystals
        has_deficit = volatile_motes
        has_deficit = exotic_gases
    }
}

{% for need_name, need in economic_need_thresholds.items() %}
    bca_country_needs_{{ need_name }} = {
        OR = {
            NOT = { has_country_flag = bca_enable_economic_management }
            has_country_flag = bca_economic_target_{{ need_name }}_unlimited
            AND = {
                NOT = { has_country_flag = bca_economic_target_{{ need_name }}_forbidden }
                {% if need.resource %}
                    OR = {
                        AND = {
                            is_variable_set = bca_economic_target_lower_{{ need_name }}
                            resource_income_compare = {
                                resource = {{ need.resource }}
                                value < bca_economic_target_lower_{{ need_name }}
                            }
                        }
                        AND = {
                            NOT = { is_variable_set = bca_economic_target_lower_{{ need_name }} }
                            resource_income_compare = {
                                resource = {{ need.resource }}
                                value < {{ need.variable }}
                            }
                        }
                    }
                {% else %}
                    check_variable_arithmetic = {
                        which = value:{{ need.value }}
                        value < {{ need.variable }}
                    }
                {% endif %}
            }
        }
    }

    bca_empire_needs_{{ need_name }} = {
        owner = {
            bca_country_needs_{{ need_name }} = yes
        }
    }

    bca_planet_build_needs_{{ need_name }} = {
        OR = {
            has_carrier_flag = bca_pf_planet_pre_construction
            AND = {
                bca_empire_needs_{{ need_name }} = yes
                OR = {
                    NOT = { has_country_flag = bca_enable_economic_management }
                    NOT = { bca_country_has_basic_deficit = yes }
                    {% if need.resource == "trade" %}
                    always = no
                    {% else %}
                    has_deficit = {{ need.resource }}
                    {% endif %}
                }
            }
        }
    }

    bca_country_surplus_{{ need_name }} = {
        has_country_flag = bca_enable_economic_management
        NOT = { has_country_flag = bca_economic_target_{{ need_name }}_unlimited }
        NOT = { has_country_flag = bca_economic_target_{{ need_name }}_forbidden }
        {% if need.resource %}
            OR = {
                AND = {
                    is_variable_set = bca_economic_target_upper_{{ need_name }}
                    resource_income_compare = {
                        resource = {{ need.resource }}
                        value > bca_economic_target_upper_{{ need_name }}
                    }
                }
                AND = {
                    NOT = { is_variable_set = bca_economic_target_upper_{{ need_name }} }
                    resource_income_compare = {
                        resource = {{ need.resource }}
                        value >= {{ need.variable }}
                    }
                }
            }
        {% else %}
            check_variable_arithmetic = {
                which = value:{{ need.value }}
                value >= {{ need.variable }}
            }
        {% endif %}
    }

    bca_empire_has_surplus_{{ need_name }} = {
        owner = {
            bca_country_surplus_{{ need_name }} = yes
        }
    }

{% endfor %}
bca_country_needs_research = {
    OR = {
        bca_country_needs_physics_research = yes
        bca_country_needs_society_research = yes
        bca_country_needs_engineering_research = yes
    }
}

bca_empire_needs_research = {
    owner = {
        bca_country_needs_research = yes
    }
}

bca_planet_build_needs_research = {
    OR = {
        has_carrier_flag = bca_pf_planet_pre_construction
        bca_empire_needs_research = yes
    }
}

bca_country_surplus_research = {
    AND = {
        bca_country_surplus_physics_research = yes
        bca_country_surplus_society_research = yes
        bca_country_surplus_engineering_research = yes
    }
}

bca_empire_has_surplus_research = {
    owner = {
        bca_country_surplus_research = yes
    }
}
