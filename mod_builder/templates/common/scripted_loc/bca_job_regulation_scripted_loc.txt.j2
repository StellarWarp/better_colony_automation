{# Phase 8: 槽位动态 scripted_loc（From 域，default 兜底） #}
{% set regulated = job_regulation_config.regulated_jobs %}
{% set slots = job_regulation_config.display_slots | default(15) %}

{% for s in range(slots) %}
{% set s_name = "s%d" % (s + 1) %}

# ── 槽位 {{ s_name }}: 图标 ──
defined_text = {
    name = BCA_JR_SLOT_{{ s_name }}_ICON_script
{% for icon, entries in regulated | selectattr("icon") | groupby("icon") %}
    text = {
        trigger = {
{% set icon_entries = entries | list %}
{% if icon_entries | length == 1 %}
            has_country_flag = bca_jr_slot_{{ s_name }}_job_{{ icon_entries[0].job }}
{% else %}
            OR = {
{% for entry in icon_entries %}
                has_country_flag = bca_jr_slot_{{ s_name }}_job_{{ entry.job }}
{% endfor %}
            }
{% endif %}
        }
        localization_key = BCA_JR_ICON_SPRITE_{{ icon }}
    }
{% endfor %}
    default = BCA_JR_ICON_FALLBACK
}

# ── 槽位 {{ s_name }}: 岗位名 ──
defined_text = {
    name = BCA_JR_SLOT_{{ s_name }}_NAME_script
{% for entry in regulated %}
    text = {
        trigger = { has_country_flag = bca_jr_slot_{{ s_name }}_job_{{ entry.job }} }
        localization_key = job_{{ entry.job }}
    }
{% endfor %}
    default = BCA_JR_SLOT_EMPTY_FALLBACK
}

# ── 槽位 {{ s_name }}: workforce ──
defined_text = {
    name = BCA_JR_SLOT_{{ s_name }}_WF_script
{% for entry in regulated %}
    text = {
        trigger = { has_country_flag = bca_jr_slot_{{ s_name }}_job_{{ entry.job }} }
        localization_key = BCA_JR_WF_{{ entry.job }}
    }
{% endfor %}
    default = BCA_JR_SLOT_EMPTY
}

# ── 槽位 {{ s_name }}: 每劳动力产出 ──
defined_text = {
    name = BCA_JR_SLOT_{{ s_name }}_OUTPUT_script
{% for entry in regulated %}
    text = {
        trigger = { has_country_flag = bca_jr_slot_{{ s_name }}_job_{{ entry.job }} }
        localization_key = BCA_JR_OUTPUT_{{ entry.job }}
    }
{% endfor %}
    default = BCA_JR_SLOT_EMPTY
}
{% endfor %}
