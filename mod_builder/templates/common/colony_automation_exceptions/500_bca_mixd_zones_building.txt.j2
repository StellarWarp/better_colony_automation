                {% for building in bucket.buildings %}
        {{ index.value }} = {
            {#  #}{{building_config(building)}}{#  #}
            {% if context_building_outputs.get(building, []) != block.outputs %}
            available = {
                {#  #}{{ resource_gate(context_building_outputs.get(building, [])) }}{#  #}
            }
            {% endif %}
        }
                    {% set index.value = index.value + 1 -%}
                {% endfor %}
            {% endif %}
        {% endfor %}
	}
}
    {% endif %}
{% endfor %}
