{% for item in zones_info %}
    {% set type = item.type %}
    {% for zone in item.zones %}
        num_zones_of_{{ zone }} = {
            complex_trigger_modifier = {
                trigger = num_zones
                parameters = {
                    type = {{ zone }}
                }
                mode = add
            }
        }

        num_zone_plan_of_{{ zone }} = {
            {% for zone_slot in ['z1','z2'] %}
                modifier = {
                    has_carrier_flag = {{ pf.flag_selected_zone(zone_slot, zone) }}
                    add = 1
                }
            {% endfor %}
            {% for zone_slot in ['z3','z4','z5'] %}
                modifier = {
                    has_carrier_flag = {{ pf.flag_selected_zone(zone_slot, zone) }}
                    check_variable = {
                        which = {{v.var_district_num_plan(zone_slot)}}
                        value > 0
                    }
                    add = 1
                }
            {% endfor %}
        }
    {% endfor %}
{% endfor %}

bca_planet_max_districts_subtract_one = {
    set = value:bca_planet_max_districts
    subtract = 1
}

{# 首都采集星球：三类资源区划平均分配，留 3 个槽位给主区划（建筑槽）。
   例：星球容量 19 → (19-3)/3 ≈ 5，即 发电 5 / 采矿 5 / 农业 5（受各自上限截断），城市 4~6。 #}
bca_capital_extraction_secondary_share = {
    set = value:bca_potential_max_districts
    subtract = 3
    divide = 3
    round = yes
    min = 1
}

{% for district_set_idx in range(1,4) %}
    {% set district_slot = 'd'~district_set_idx %}
    bca_district_max_add_{{ district_slot }} = {
    {# capped #}
        {% for district in all_district_set[district_set_idx] %}
            {% if district not in always_uncapped_districts %}
                add = value:bca_planet_max_districts_of|type|{{ district }}|
            {% endif %}
        {% endfor %}
    {# uncapped #}
        {% for district in all_district_set[district_set_idx] %}
            {% if district in always_uncapped_districts %}
                modifier = {
                    bca_can_build_{{ district }} = yes
                    set = value:bca_planet_max_districts
                }
            {% endif %}
        {% endfor %}
    }

    bca_district_max_build_{{ district_slot }} = {
        set = value:bca_district_max_add_{{ district_slot }}
        max = value:bca_planet_max_districts_subtract_one
        modifier = {
            bca_has_advance_secondary_districts = yes
            subtract = 2
        }
    }
{% endfor %}

{% for district_set_idx in range(1,4) %}
    {% set district_slot = 'd'~district_set_idx %}
    bca_potential_district_max_add_{{ district_slot }} = {
    {# capped #}
        {% for district in all_district_set[district_set_idx] %}
            {% if district not in always_uncapped_districts %}
                add = value:bca_planet_max_districts_of|type|{{ district }}|
            {% endif %}
        {% endfor %}
    {# uncapped #}
        {% for district in all_district_set[district_set_idx] %}
            {% if district in always_uncapped_districts %}
                modifier = {
                    bca_can_build_{{ district }} = yes
                    set = value:bca_planet_max_districts
                }
            {% endif %}
        {% endfor %}

        {% if district_set_idx == 1 %}
            modifier = {
                bca_can_build_building_generator_districts_1 = yes
                add = value:bca_potential_energy_district_max_inc
            }
        {% endif %}
        {% if district_set_idx == 2 %}
            modifier = {
                bca_can_build_building_mining_districts_1 = yes
                add = value:bca_potential_minerals_district_max_inc
            }
        {% endif %}
        {% if district_set_idx == 3 %}
            modifier = {
                bca_can_build_building_farming_districts_1 = yes
                add = value:bca_potential_food_district_max_inc
            }
        {% endif %}
        max = value:bca_planet_max_districts
    }

    bca_potential_district_max_build_{{ district_slot }} = {
        set = value:bca_potential_district_max_add_{{ district_slot }}
        max = value:bca_planet_max_districts_subtract_one
        modifier = {
            bca_has_advance_secondary_districts = yes
            subtract = 2
        }
    }
{% endfor %}
