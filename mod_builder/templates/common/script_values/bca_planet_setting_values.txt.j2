{% import 'component/planet_variable.j2' as v -%}
{% import 'component/conditions.j2' as cond with context %}
{% import 'component/planet_flag_ps.j2' as pf with context -%}

bca_potential_max_districts = {
    complex_trigger_modifier = {
        trigger = num_districts
        parameters = {
            type = any
        }
        mode = set
    }
    complex_trigger_modifier = {
        trigger = num_free_districts
        parameters = {
            type = any
        }
        mode = add
    }
    add = value:bca_num_queued_districts
    # set = value:bca_planet_max_districts
}

bca_num_free_secondary_districts_plan = {
    set = value:bca_potential_max_districts
    subtract = value:bca_committed_primary_district
    {% for i in range(3,6) %}
        {% set zone_slot = "z"~i %}
        subtract = {{ v.var_district_num_plan(zone_slot) }}
    {% endfor %}
}

bca_num_free_secondary_districts_plan_full_secondary_districts = {
    set = value:bca_potential_max_districts
    subtract = 1
    {% for i in range(3,6) %}
        {% set zone_slot = "z"~i %}
        subtract = {{ v.var_district_num_plan(zone_slot) }}
    {% endfor %}
}

bca_num_free_primary_districts_plan = {
    {% for i in range(3,6) %}
        {% set zone_slot = "z"~i %}
        add = {{ v.var_district_num_plan(zone_slot) }}
    {% endfor %}
    subtract = value:bca_committed_secondary_district
}

bca_num_primary_districts_plan = {
    {# 城市型专精（统一中心 / 科研 / 合金 / 消费品 / 贸易）：这类星球本身就是靠城市区划提供建筑槽，
       继续沿用「容量 − 副区划方案」，把它们该铺的城市铺满。 #}
    if = {
        limit = {
            OR = {
                has_unity_designation = yes
                has_research_designation = yes
                has_foundry_designation = yes
                has_factory_designation = yes
                has_trade_designation = yes
            }
        }
        set = value:bca_potential_max_districts
        {% for i in range(3,6) %}
            {% set zone_slot = "z"~i %}
            subtract = {{ v.var_district_num_plan(zone_slot) }}
        {% endfor %}
    }
    else = {
        {# 其它星球（尤其一产星球）：基线 = 已建主区划数量，只有确实需要时才多给 1 个， #}
        {# 避免"采矿区划一建满就自动开始铺城市"（2026-11-06 玩家反馈）。 #}
        set = value:num_district_d0
        if = {
            limit = {
                OR = {
                    {# 住房不足 #}
                    free_housing < 1
                    {# 有人失业、岗位不够 #}
                    num_unemployed > 0
                    {# 建筑槽已满，而且这颗星球仍然想建东西（专精产出仍低于目标）→ 需要新城市提供建筑槽 #}
                    AND = {
                        free_building_slots < 1
                        OR = {
                            AND = {
                                has_generator_designation = yes
                                bca_planet_district_needs_energy = yes
                            }
                            AND = {
                                has_mining_designation = yes
                                bca_planet_district_needs_minerals = yes
                            }
                            AND = {
                                has_farming_designation = yes
                                bca_planet_district_needs_food = yes
                            }
                        }
                    }
                }
            }
            add = 1
        }
    }
    min = 1
    max = value:bca_potential_max_districts
}

bca_num_secondary_districts_plan = {
    {% for i in range(3,6) %}
        {% set zone_slot = "z"~i %}
        add = {{ v.var_district_num_plan(zone_slot) }}
    {% endfor %}
    min = 0
}

# floor(value:bca_potential_max_districts * RATIO)
bca_num_main_districts_from_ratio = {
    set = value:bca_potential_max_districts
    multiply = $RATIO$
    round = yes
    min = 1
}
bca_built_primary_districts_to_ratio = {
    set = value:num_primary_district
    divide = value:bca_potential_max_districts
}
bca_plan_primary_districts_to_ratio = {
    set = value:bca_num_primary_districts_plan
    divide = value:bca_potential_max_districts
}
bca_built_secondary_districts_to_ratio = {
    set = value:num_secondary_district
    divide = value:bca_potential_max_districts
}
bca_plan_secondary_districts_to_ratio = {
    {% for i in range(3,6) %}
        {% set zone_slot = "z"~i %}
        add = {{ v.var_district_num_plan(zone_slot) }}
    {% endfor %}
    divide = value:bca_potential_max_districts
}



num_primary_district = {
    set = value:num_district_d0
}

num_secondary_district = {
    {% for district in secondary_districts %}
        complex_trigger_modifier = {
            trigger = num_districts
            parameters = {
                type = {{ district }}
            }
            mode = add
        }
    {% endfor %}
}

{% set all_district_set = [primary_districts, secondary_districts_d1, secondary_districts_d2, secondary_districts_d3] %}
{% for district_set_idx in range(4) %}
    num_district_d{{ district_set_idx }} = {
        {% for district in all_district_set[district_set_idx] %}
            complex_trigger_modifier = {
                trigger = num_districts
                parameters = {
                    type = {{ district }}
                }
                mode = add
            }
        {% endfor %}
        {% if district_set_idx == 0 %}
            modifier = {
                has_modifier = bca_pm_arcology_project_candidate
                divide = 2
            }
            round = yes
        {% endif %}
    }

    bca_committed_district_d{{ district_set_idx }} = {
        set = value:num_district_d{{ district_set_idx }}
        add = bca_queued_district_d{{ district_set_idx }}
    }
{% endfor %}

bca_committed_primary_district = {
    set = value:bca_committed_district_d0
}

bca_committed_secondary_district = {
    set = value:bca_committed_district_d1
    add = value:bca_committed_district_d2
    add = value:bca_committed_district_d3
}


num_free_primary_district = {
    {% for district in primary_districts %}
        complex_trigger_modifier = {
            trigger = num_free_districts
            parameters = {
                type = {{ district }}
            }
            mode = set
            potential = {
                bca_can_build_{{ district }} = yes
            }
        }
    {% endfor %}
}

num_free_secondary_district = {
    {% for district in secondary_districts %}
        complex_trigger_modifier = {
            trigger = num_free_districts
            parameters = {
                type = {{ district }}
            }
            mode = set
            potential = {
                bca_can_build_{{ district }} = yes
            }
        }
    {% endfor %}
}

{% for district_set_idx in range(4) %}
    num_free_district_d{{ district_set_idx }} = {
        {% for district in all_district_set[district_set_idx] %}
            complex_trigger_modifier = {
                trigger = num_free_districts
                parameters = { type = {{ district }} }
                mode = set
                potential = {
                    bca_can_build_{{ district }} = yes
                }
            }
        {% endfor %}
    }
{% endfor %}

num_zones_primary_district = {
