{#
  Phase 7: 劳动力因子 script value
  在 pop_group 作用域直接用 modifier:xxx 读取，无需 export
#}
{% set regulated = job_regulation_config.regulated_jobs %}

{% for entry in regulated if entry.pop_category %}
bca_jr_f1_{{ entry.job }} = {
    base = 1
    add = modifier:pop_workforce_mult
    add = modifier:pop_{{ entry.job }}_workforce_mult
}

bca_jr_f2_{{ entry.job }} = {
    base = 1
    add = modifier:pop_bonus_workforce_mult
    add = modifier:pop_cat_{{ entry.pop_category }}_bonus_workforce_mult
    add = modifier:pop_{{ entry.job }}_bonus_workforce_mult
}
{% endfor %}
