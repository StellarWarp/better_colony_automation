{% for group in category_groups %}
    {% set group_resources = [] %}
    {% for cat in group.resources %}
        {% if cat in categories %}
            {% set _ = group_resources.append(cat) %}
        {% endif %}
    {% endfor %}
    {% if group_resources %}
        bca_jr_select_category_group_{{ group.name }}_selected = {
            potential = {
                exists = from
                from = {
                    check_variable = { which = bca_gui_active_tab value = 1 }
                    {% for cat in group_resources %}
                        has_country_flag = bca_jr_filter_{{ cat }}
                    {% endfor %}
                    {% for cat in categories %}
                        {% if cat not in group_resources %}
                            NOT = { has_country_flag = bca_jr_filter_{{ cat }} }
                        {% endif %}
                    {% endfor %}
                }
            }
            allow = { always = yes }
            effect = { hidden_effect = { from = { country_event = { id = colony_automation_event.2001 } } } }
        }
        bca_jr_select_category_group_{{ group.name }}_unselected = {
            potential = {
                exists = from
                from = {
                    check_variable = { which = bca_gui_active_tab value = 1 }
                    NOR = {
                        AND = {
                            {% for cat in group_resources %}
                                has_country_flag = bca_jr_filter_{{ cat }}
                            {% endfor %}
                            {% for cat in categories %}
                                {% if cat not in group_resources %}
                                    NOT = { has_country_flag = bca_jr_filter_{{ cat }} }
                                {% endif %}
                            {% endfor %}
                        }
                    }
                }
            }
            allow = { always = yes }
            effect = {
                hidden_effect = {
                    from = {
                        remove_country_flag = bca_jr_filter_all
                        remove_country_flag = bca_jr_filter_other
                        {% for cat in categories %}
                            {% if cat in group_resources %}
                                set_country_flag = bca_jr_filter_{{ cat }}
                            {% else %}
                                remove_country_flag = bca_jr_filter_{{ cat }}
                            {% endif %}
                        {% endfor %}
                        country_event = { id = colony_automation_event.2001 }
                    }
                }
            }
        }
    {% endif %}
{% endfor %}

{# ---- 槽位可见性 ---- #}
{% for s in range(slots) %}
    {% set s_name = "s%d" % (s + 1) %}
    bca_jr_slot_visible_{{ s_name }} = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                check_variable_arithmetic = { which = bca_jr_display_count value >= {{ s + 1 }} }
            }
        }
        allow = { always = yes }
    }
    bca_jr_slot_wf_tooltip_{{ s_name }} = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                check_variable_arithmetic = { which = bca_jr_display_count value >= {{ s + 1 }} }
            }
        }
        allow = { always = yes }
        effect = {
            custom_tooltip = BCA_JR_SLOT_{{ s_name }}_WF_TOOLTIP
            hidden_effect = { }
        }
    }
    bca_jr_slot_mode_none_{{ s_name }} = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                check_variable_arithmetic = { which = bca_jr_display_count value >= {{ s + 1 }} }
            }
        }
        allow = {
            custom_tooltip = {
                fail_text = BCA_JR_MANUAL_MODE_NOT_IMPLEMENTED
                always = no
            }
        }
    }
    bca_jr_slot_locate_{{ s_name }} = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                check_variable_arithmetic = { which = bca_jr_display_count value >= {{ s + 1 }} }
            }
        }
        allow = { always = yes }
        effect = {
            custom_tooltip = BCA_JR_LOCATE_TOOLTIP
            hidden_effect = {
                from = {
                    bca_jr_locate_slot_job = { SLOT_NAME = {{ s_name }} }
                }
            }
        }
    }
{% endfor %}

{# ---- 槽位控制按钮：自动 -> 手动 -> 清空 -> 最多 -> 自动 ---- #}
{% for s in range(slots) %}
    {% set s_name = "s%d" % (s + 1) %}
    bca_jr_slot_mode_{{ s_name }}_auto = {
        potential = {
            exists = from
            from = {
                has_country_flag = bca_jr_slot_{{ s_name }}_mapped
                check_variable = { which = bca_gui_active_tab value = 1 }
                has_country_flag = bca_jr_slot_{{ s_name }}_mode_auto
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = { bca_jr_cycle_slot_job_mode = { SLOT_NAME = {{ s_name }} } }
            }
        }
    }
    bca_jr_slot_mode_{{ s_name }}_manual = {
        potential = {
            exists = from
            from = {
                has_country_flag = bca_jr_slot_{{ s_name }}_mapped
                check_variable = { which = bca_gui_active_tab value = 1 }
                has_country_flag = bca_jr_slot_{{ s_name }}_mode_manual
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = { bca_jr_cycle_slot_job_mode = { SLOT_NAME = {{ s_name }} } }
            }
        }
    }
    bca_jr_slot_mode_{{ s_name }}_empty = {
        potential = {
            exists = from
            from = {
                has_country_flag = bca_jr_slot_{{ s_name }}_mapped
                check_variable = { which = bca_gui_active_tab value = 1 }
                has_country_flag = bca_jr_slot_{{ s_name }}_mode_empty
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = { bca_jr_cycle_slot_job_mode = { SLOT_NAME = {{ s_name }} } }
            }
        }
    }
    bca_jr_slot_mode_{{ s_name }}_full = {
        potential = {
            exists = from
            from = {
                has_country_flag = bca_jr_slot_{{ s_name }}_mapped
                check_variable = { which = bca_gui_active_tab value = 1 }
                has_country_flag = bca_jr_slot_{{ s_name }}_mode_full
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = { bca_jr_cycle_slot_job_mode = { SLOT_NAME = {{ s_name }} } }
            }
        }
    }
{% endfor %}

{# ---- Tab 选择（choice_row 自动加 _selected/_unselected 后缀）---- #}
{% set tab_names = ['economy','jobs','automation'] %}
{% for tab in tab_names %}
    bca_gui_select_tab_{{ tab }}_selected = {
        potential = {
            exists = from
            from = { check_variable = { which = bca_gui_active_tab value = {{ loop.index0 }} } }
        }
        allow = { always = yes }
    }
    bca_gui_select_tab_{{ tab }}_unselected = {
        potential = {
            exists = from
            from = { NOR = { check_variable = { which = bca_gui_active_tab value = {{ loop.index0 }} } } }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = {
                    set_variable = { which = bca_gui_active_tab value = {{ loop.index0 }} }
                    {% if tab == 'jobs' %}
                        country_event = { id = colony_automation_event.2001 }
                    {% else %}
                        bca_jr_clear_slot_mapping = yes
                    {% endif %}
                }
            }
        }
    }
{% endfor %}

