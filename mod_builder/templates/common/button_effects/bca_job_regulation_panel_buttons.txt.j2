{# Phase 8: 岗位调控面板按钮效果（from 防御版） #}
{% set regulated = job_regulation_config.regulated_jobs %}
{% set slots = job_regulation_config.display_slots | default(15) %}
{% set categories = job_regulation_config.categories %}
{% set category_groups = [
    {"name": "basic", "resources": ["energy", "minerals", "food"]},
    {"name": "industry", "resources": ["alloys", "consumer_goods", "trade"]},
    {"name": "knowledge", "resources": ["unity", "physics_research", "society_research", "engineering_research"]},
    {"name": "rare", "resources": ["rare_crystals", "volatile_motes", "exotic_gases"]},
    ] %}

{# ---- 类别选择（多选过滤；每次点击都重新统计）---- #}
{% for cat in categories %}
    bca_jr_select_category_{{ cat }}_selected = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                has_country_flag = bca_jr_filter_{{ cat }}
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = {
                    remove_country_flag = bca_jr_filter_all
                    remove_country_flag = bca_jr_filter_other
                    remove_country_flag = bca_jr_filter_{{ cat }}
                    country_event = { id = colony_automation_event.2001 }
                }
            }
        }
    }
    bca_jr_select_category_{{ cat }}_unselected = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                NOT = { has_country_flag = bca_jr_filter_{{ cat }} }
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = {
                    remove_country_flag = bca_jr_filter_all
                    remove_country_flag = bca_jr_filter_other
                    set_country_flag = bca_jr_filter_{{ cat }}
                    country_event = { id = colony_automation_event.2001 }
                }
            }
        }
    }
{% endfor %}

bca_jr_refresh_panel = {
    potential = { exists = from from = { check_variable = { which = bca_gui_active_tab value = 1 } } }
    allow = { always = yes }
    effect = {
        hidden_effect = {
            from = { country_event = { id = colony_automation_event.2001 } }
        }
    }
}

bca_jr_show_all_outputs_selected = {
    potential = { exists = from from = { check_variable = { which = bca_gui_active_tab value = 1 } has_country_flag = bca_jr_show_all_outputs } }
    allow = { always = yes }
    effect = {
        hidden_effect = {
            from = {
                remove_country_flag = bca_jr_show_all_outputs
            }
        }
    }
}

bca_jr_show_all_outputs_unselected = {
    potential = { exists = from from = { check_variable = { which = bca_gui_active_tab value = 1 } NOT = { has_country_flag = bca_jr_show_all_outputs } } }
    allow = { always = yes }
    effect = {
        hidden_effect = {
            from = {
                set_country_flag = bca_jr_show_all_outputs
            }
        }
    }
}

{% set sort_modes = ["workforce", "output", "status"] %}
{% for mode in sort_modes %}
    bca_jr_sort_{{ mode }}_selected = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                {% if mode == "workforce" %}
                    OR = {
                        has_country_flag = bca_jr_sort_workforce
                        NOR = {
                            {% for other in sort_modes %}
                                has_country_flag = bca_jr_sort_{{ other }}
                            {% endfor %}
                        }
                    }
                {% else %}
                    has_country_flag = bca_jr_sort_{{ mode }}
                {% endif %}
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = {
                    {% for other in sort_modes %}
                        {% if other == mode %}
                            set_country_flag = bca_jr_sort_{{ other }}
                        {% else %}
                            remove_country_flag = bca_jr_sort_{{ other }}
                        {% endif %}
                    {% endfor %}
                }
            }
        }
    }
    bca_jr_sort_{{ mode }}_unselected = {
        potential = {
            exists = from
            from = {
                check_variable = { which = bca_gui_active_tab value = 1 }
                {% if mode == "workforce" %}
                    NOR = {
                        has_country_flag = bca_jr_sort_workforce
                        NOR = {
                            {% for other in sort_modes %}
                                has_country_flag = bca_jr_sort_{{ other }}
                            {% endfor %}
                        }
                    }
                {% else %}
                    NOT = { has_country_flag = bca_jr_sort_{{ mode }} }
                {% endif %}
            }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = {
                    {% for other in sort_modes %}
                        {% if other == mode %}
                            set_country_flag = bca_jr_sort_{{ other }}
                        {% else %}
                            remove_country_flag = bca_jr_sort_{{ other }}
                        {% endif %}
                    {% endfor %}
                    country_event = { id = colony_automation_event.2001 }
                }
            }
        }
    }
{% endfor %}

