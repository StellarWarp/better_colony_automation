{# Global settings tab navigation is part of the main mod. #}
{% set tab_names = ['economy','jobs','automation'] %}
{% for tab in tab_names %}
    bca_gui_select_tab_{{ tab }}_selected = {
        potential = {
            exists = from
            from = { check_variable = { which = bca_gui_active_tab value = {{ loop.index0 }} } }
        }
        allow = { always = yes }
    }
    bca_gui_select_tab_{{ tab }}_unselected = {
        potential = {
            exists = from
            from = { NOR = { check_variable = { which = bca_gui_active_tab value = {{ loop.index0 }} } } }
        }
        allow = { always = yes }
        effect = {
            hidden_effect = {
                from = {
                    set_variable = { which = bca_gui_active_tab value = {{ loop.index0 }} }
                    if = {
                        limit = {
                            check_variable = {
                                which = @bca_submod_job_regulation
                                value > 0
                            }
                        }
                        {% if tab == 'jobs' %}
                            country_event = { id = colony_automation_event.2001 }
                        {% else %}
                            bca_jr_close_panel = yes
                        {% endif %}
                    }
                }
            }
        }
    }
{% endfor %}

bca_tab_visible_0 = {
    potential = { exists = from from = { check_variable_arithmetic = { which = bca_gui_active_tab value <= 0 } } }
    allow = { always = yes }
}
bca_tab_visible_1 = {
    potential = { exists = from from = { check_variable = { which = bca_gui_active_tab value = 1 } } }
    allow = { always = yes }
}
bca_tab_visible_2 = {
    potential = { exists = from from = { check_variable = { which = bca_gui_active_tab value = 2 } } }
    allow = { always = yes }
}
