{% import 'component/planet_flag_ps.j2' as pf with context %}
{% import 'component/planet_variable.j2' as v with context %}
{% import 'component/conditions.j2' as cond with context %}
{% import 'component/zone_setting_option_operation.j2' as op with context -%}

namespace = colony_automation_event

# check to initialize colony automation for all planets
event = {
	id = colony_automation_event.25
	hide_window = yes
	is_triggered_only = yes

	immediate = {
        every_country = {
            limit = {
                is_ai = no
            }
            every_owned_colony = {
                limit = {
                    is_colony = yes
                    NOT = {
                        has_carrier_flag = bca_pf_ps_initialized
                   }
                }
                carrier_event = { id = colony_automation_event.26 }
            }
        }
    }
}


# set by current layout
# on_colonized
# on_planet_transfer
carrier_event = {
    id = colony_automation_event.26
    hide_window = yes
    is_triggered_only = yes

    trigger = {
        always = yes
    }

    immediate = {
        if = {
            carrier_event = { id = colony_automation_event.12 }
            carrier_event = { id = colony_automation_event.11 }
            limit = {
                owner = {
                    is_ai = no
                }
            }
            remove_carrier_flag = bca_pf_can_build_extra_zones_for_storage
            remove_carrier_flag = bca_pf_district_balanced
            bca_clear_designation_flag = yes
            bca_designation_sync_with_system = yes
            bca_primary_zone_setting_set_by_current_zones = yes
            bca_secondary_zone_setting_set_by_current_zones = yes
            # init for slot that's not selected by current zones
            {% for zone_slot in ['z1','z2','z3','z4','z5'] %}
            if = {
                limit = {
                    NOT = { bca_has_zone_plan = { ZONE_SLOT = {{ zone_slot }} } }
                }
                {{ op.auto_select_default_zone(zone_slot) }}
            }
            {% endfor %}
            if = {
                limit = {
                    bca_has_advance_secondary_districts = yes
                }
                bca_set_zx_for_identical_secondary_zone_plan = yes
                try_set_secondary_districts_plan_zero_to_one = yes
            }
            if = {
                limit = {
                    owner = {
                        has_country_flag = bca_default_disable_auto_destruction_building
                    }
                }
                set_carrier_flag = bca_pf_disable_planet_auto_destruction_building
            }
            else = {
                remove_carrier_flag = bca_pf_disable_planet_auto_destruction_building
            }
            if = {
                limit = {
                    owner = {
                        has_country_flag = bca_default_disable_auto_destruction_district
                    }
                }
                set_carrier_flag = bca_pf_disable_planet_auto_destruction_district
            }
            else = {
                remove_carrier_flag = bca_pf_disable_planet_auto_destruction_district
            }
            if = {
                limit = {
                    owner = {
                        has_country_flag = bca_default_disable_auto_destruction_zone
                    }
                }
                set_carrier_flag = bca_pf_disable_planet_auto_destruction_zone
            }
            else = {
                remove_carrier_flag = bca_pf_disable_planet_auto_destruction_zone
            }
            set_carrier_flag = {{ pf.flag_bca_initialized() }}
        }
        else = {
            remove_carrier_flag = bca_pf_district_balanced
            bca_clear_designation_flag = yes
            clear_open_selector = yes
            {% for zone_slot in ['z1','z2','z3','z4','z5','zx'] %}
                {{ op.clear_zone_selection(zone_slot) }}
            {% endfor %}
            remove_carrier_flag = {{ pf.flag_bca_initialized() }}
        }
    }
}

# reset to default
carrier_event = {
    id = colony_automation_event.27
    hide_window = yes
    is_triggered_only = yes

    trigger = {
        always = yes
    }

    immediate = {
        carrier_event = { id = colony_automation_event.12 }
        carrier_event = { id = colony_automation_event.11 }
        remove_carrier_flag = bca_pf_can_build_extra_zones_for_storage
        remove_carrier_flag = bca_pf_district_balanced
        bca_clear_designation_flag = yes
        bca_designation_sync_with_system = yes
        {% for zone_slot in ['z1','z2','z3','z4','z5'] %}
        {{ op.auto_select_default_zone(zone_slot) }}
        {% endfor %}
        if = {
            limit = {
                bca_has_advance_secondary_districts = yes
            }
            bca_set_zx_for_identical_secondary_zone_plan = yes
            try_set_secondary_districts_plan_zero_to_one = yes
        }
        if = {
            limit = {
                owner = {
                    has_country_flag = bca_default_disable_auto_destruction_building
                }
            }
            set_carrier_flag = bca_pf_disable_planet_auto_destruction_building
        }
        else = {
            remove_carrier_flag = bca_pf_disable_planet_auto_destruction_building
        }
        if = {
            limit = {
                owner = {
                    has_country_flag = bca_default_disable_auto_destruction_district
                }
            }
            set_carrier_flag = bca_pf_disable_planet_auto_destruction_district
        }
        else = {
            remove_carrier_flag = bca_pf_disable_planet_auto_destruction_district
        }
        if = {
            limit = {
                owner = {
                    has_country_flag = bca_default_disable_auto_destruction_zone
                }
            }
            set_carrier_flag = bca_pf_disable_planet_auto_destruction_zone
        }
        else = {
            remove_carrier_flag = bca_pf_disable_planet_auto_destruction_zone
        }
        set_carrier_flag = {{ pf.flag_bca_initialized() }}
    }
}

# secondary district do not has tech to build zone at start
carrier_event = {
    id = colony_automation_event.28
    hide_window = yes
    is_triggered_only = yes

    trigger = {
        always = yes
    }

    immediate = {
        # init for slot that's not selected by current zones
        {% for zone_slot in ['z3','z4','z5'] %}
        if = {
            limit = {
                NOT = { bca_has_zone_plan = { ZONE_SLOT = {{ zone_slot }} } }
            }
            {{ op.auto_select_default_zone(zone_slot) }}
        }
        {% endfor %}
    }
}

