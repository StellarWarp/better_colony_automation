{#
Phase 5b: 月度岗位调控评估事件
colony_automation_event.2000 — 清除旧标记 → 评估每个调控岗位
#}
namespace = colony_automation_event

carrier_event = {
    id = colony_automation_event.2000
    hide_window = yes
    is_triggered_only = yes

    trigger = {
        exists = owner
        owner = { has_country_flag = bca_jr_enabled }
    }

    immediate = {
        # 清除上次 job_changes 消费后的档位标记。
        bca_jr_clear_all_flags = yes

        bca_jr_evaluate_all = yes
    }
}

{# GUI 数据刷新：聚合所有殖民地 workforce 到 country 变量 #}
{% set regulated = job_regulation_config.regulated_jobs %}
country_event = {
    id = colony_automation_event.2001
    hide_window = yes
    is_triggered_only = yes

    immediate = {
        # 清零上一轮显示数据与 country 级累加器
        bca_jr_clear_slot_mapping = yes
        bca_jr_clear_country_job_totals = yes
        set_country_flag = bca_jr_collect_country_totals

        # 各殖民地：只刷新统计数据，不触发月度调控或冷却变化；统计 effect 会在 flag 开启时直接汇总到 owner。
        every_owned_colony = {
            set_carrier_flag = bca_jr_check_all_jobs
            bca_jr_clear_accumulators = yes
            bca_jr_collect_checked_job_stats = yes
            bca_jr_finalize_job_stats = yes
            remove_carrier_flag = bca_jr_check_all_jobs
            bca_jr_clear_accumulators = yes
        }
        remove_country_flag = bca_jr_collect_country_totals

        # 填槽位
        bca_jr_normalize_job_filters = yes
        bca_jr_refresh_slot_data = yes

        # Slot 变量已经保存了面板显示需要的数据；country totals 只用于本次排序/筛选。
        bca_jr_clear_country_job_totals = yes
    }
}
