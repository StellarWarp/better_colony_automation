            gsc.choice_row(name = "pop_assembly", text = "BCA_GLOBAL_SETTINGS_POP_ASSEMBLY_BUILDINGS", tooltip = "BCA_GLOBAL_SETTINGS_POP_ASSEMBLY_BUILDINGS_TOOLTIP",
