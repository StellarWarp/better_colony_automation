}) %}
{% endfor %}
{% set positive_options = [] %}
{% for option in row.positive_options %}
{% set _ = positive_options.append({
    "name": option.name,
    "text": option.text,
    "effect": row.effect_prefix ~ "_" ~ option.name
}) %}
{% endfor %}
