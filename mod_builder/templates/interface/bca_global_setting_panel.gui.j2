        }}
        {{
        gsc.auto_demolition_row(
            name = "zones",
            text = "BCA_GLOBAL_SETTINGS_DEFAULT_ZONE_AUTO_DEMOLITION",
            status_text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ZONE_AUTO_DEMOLITION_STATUS",
            default_enable_current_effect = "bca_global_settings_default_auto_destruction_zones_enable_current",
            default_enable_target_effect = "bca_global_settings_default_auto_destruction_zones_enable",
            default_disable_current_effect = "bca_global_settings_default_auto_destruction_zones_disable_current",
            default_disable_target_effect = "bca_global_settings_default_auto_destruction_zones_disable",
            default_enable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_ZONE_AUTO_DEMOLITION_ON_CURRENT_TOOLTIP",
            default_enable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_ZONE_AUTO_DEMOLITION_ON_TARGET_TOOLTIP",
            default_disable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_ZONE_AUTO_DEMOLITION_OFF_CURRENT_TOOLTIP",
            default_disable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_ZONE_AUTO_DEMOLITION_OFF_TARGET_TOOLTIP",
            apply_enable_effect = "bca_global_settings_auto_destruction_zones_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_zones_disable",
            apply_enable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ZONE_AUTO_DEMOLITION_ENABLE_TOOLTIP",
            apply_disable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ZONE_AUTO_DEMOLITION_DISABLE_TOOLTIP",
            x = left_column_x,
            y = auto_demo_fourth_row_y,
            width = full_width,
            height = auto_demo_row_height
