{% call shell.event_window_shell(
    window_name = "bca_global_setting_panel",
    header_text = "BCA_GLOBAL_SETTINGS_HEADER",
    width = panel_width,
    height = panel_height,
    show_native_event_text = false
) %}
        containerWindowType = {
            name = "settings_scroll_container"
            position = { x = 0 y = {{ scroll_container_y }} }
            size = { width = {{ panel_width }} height = {{ scroll_container_height }} }
            verticalScrollbar = "right_vertical_slider"
            background = {
                name = "background"
                spriteType = "GFX_tiles_dark_area_cut_8"
            }

        {# ---- Tab 按钮栏 ---- #}
{% set tab_button_width = (full_width - content_x - 20) // 3 %}
        {{
        gsc.choice_row(
            name = "tab_select", text = "", tooltip = "",
            x = content_x, y = tab_bar_y, width = full_width, height = 40,
            button_width = tab_button_width, button_gap = 2,
            options = [
                {"name": "economy", "text": "BCA_GLOBAL_SETTINGS_ECONOMIC_TARGETS_SECTION", "effect": "bca_gui_select_tab_economy"},
                {"name": "jobs", "text": "BCA_GLOBAL_SETTINGS_JOB_REGULATION_SECTION", "effect": "bca_gui_select_tab_jobs"},
                {"name": "automation", "text": "BCA_GLOBAL_SETTINGS_AUTOMATION_BEHAVIORS_SECTION", "effect": "bca_gui_select_tab_automation"}
            ]
        )
        }}

        {# ═══════════════════════════════════════════════════════ #}
        {# Tab 0: Economy                                            #}
        {# ═══════════════════════════════════════════════════════ #}
        effectButtonType = { name = "eco_section_title" position = { x = {{ content_x }} y = {{ tab_section_y }} } size = { x = {{ full_width }} y = 28 } font = "malgun_goth_24" buttonText = "BCA_GLOBAL_SETTINGS_ECONOMIC_TARGETS_SECTION" alwaysTransparent = yes effect = "bca_tab_visible_0" }
        effectButtonType = { name = "eco_section_hint" position = { x = {{ content_x }} y = {{ tab_hint_y }} } size = { x = {{ full_width }} y = 42 } font = "cg_16b" buttonText = "BCA_GLOBAL_SETTINGS_ECONOMIC_TARGETS_HINT" alwaysTransparent = yes effect = "bca_tab_visible_0" }
        {{
        gsc.choice_row(
            name = "economic_management",
            text = "BCA_GLOBAL_SETTINGS_ECONOMIC_MANAGEMENT",
            tooltip = "BCA_GLOBAL_SETTINGS_ECONOMIC_MANAGEMENT_TOOLTIP",
            x = content_x, y = tab_content_y, width = full_width, height = 32,
            button_width = 72, button_gap = 10, options = economic_management_choices,
            label_effect = "bca_tab_visible_0"
        )
        }}
{% for row in economic_rows %}
{% set row_y = tab_content_y + 38 + loop.index0 * (economy_row_height + economy_row_gap) %}
{% set negative_options = [] %}
{% for option in row.negative_options %}
{% set _ = negative_options.append({"name": option.name, "text": option.text, "effect": row.effect_prefix ~ "_" ~ option.name}) %}
{% endfor %}
{% set positive_options = [] %}
{% for option in row.positive_options %}
{% set _ = positive_options.append({"name": option.name, "text": option.text, "effect": row.effect_prefix ~ "_" ~ option.name}) %}
{% endfor %}
        {{
        gsc.multi_step_value_row(
            name = "economic_" ~ row.name, text = row.text, value_text = row.value_text,
            status_text = row.status_text, tooltip = row.tooltip, value_effect = row.mode_effect,
            value_tooltip = "BCA_GLOBAL_SETTINGS_ECONOMIC_TARGET_MODE_TOOLTIP",
            negative_options = negative_options, positive_options = positive_options,
            x = content_x, y = row_y, width = full_width, height = economy_row_height,
            value_width = 76, button_width = 46, button_gap = 6, control_gap = 8,
            label_effect = "bca_tab_visible_0", status_effect = "bca_tab_visible_0"
        )
        }}
{% endfor %}

        {# ═══════════════════════════════════════════════════════ #}
        {# Tab 1: Jobs                                               #}
        {# ═══════════════════════════════════════════════════════ #}
        effectButtonType = { name = "jr_section_title" position = { x = {{ content_x }} y = {{ tab_section_y }} } size = { x = {{ full_width }} y = 28 } font = "malgun_goth_24" buttonText = "BCA_GLOBAL_SETTINGS_JOB_REGULATION_SECTION" alwaysTransparent = yes effect = "bca_tab_visible_1" }
        effectButtonType = { name = "jr_section_hint" position = { x = {{ content_x }} y = {{ tab_hint_y }} } size = { x = {{ full_width }} y = 42 } font = "cg_16b" buttonText = "BCA_GLOBAL_SETTINGS_JOB_REGULATION_HINT" alwaysTransparent = yes effect = "bca_tab_visible_1" }

        {{
        gsc.choice_row(
            name = "jr_global_toggle",
            text = "BCA_JR_GLOBAL_ENABLE",
            tooltip = "",
            x = content_x, y = jr_global_y, width = full_width, height = 32,
            button_width = 72, button_gap = 10,
            options = [
                {"name": "off", "text": "BCA_GLOBAL_SETTINGS_DISABLED", "effect": "bca_jr_global_off"},
                {"name": "on", "text": "BCA_GLOBAL_SETTINGS_ENABLED", "effect": "bca_jr_global_on"}
            ],
            label_effect = "bca_tab_visible_1"
        )
        }}

        {{ jr.category_bar(categories, content_x, jr_cat_bar_y, jr_cat_button_width, jr_cat_button_gap, jr_cat_button_height) }}

        {{ jr.table_header(content_x, jr_header_y) }}

        {{ jr.slot_list(jr_slots, content_x + 4, jr_list_start_y + 4, jr_slot_h, full_width - 10) }}

        {# ═══════════════════════════════════════════════════════ #}
        {# Tab 2: Automation                                         #}
        {# ═══════════════════════════════════════════════════════ #}
        effectButtonType = { name = "auto_section_title" position = { x = {{ content_x }} y = {{ tab_section_y }} } size = { x = {{ full_width }} y = 28 } font = "malgun_goth_24" buttonText = "BCA_GLOBAL_SETTINGS_AUTOMATION_BEHAVIORS_SECTION" format = center vertical_alignment = center alwaysTransparent = yes effect = "bca_tab_visible_2" }
        effectButtonType = { name = "auto_section_hint" position = { x = {{ content_x }} y = {{ tab_hint_y }} } size = { x = {{ full_width }} y = 42 } font = "cg_16b" buttonText = "BCA_GLOBAL_SETTINGS_AUTOMATION_BEHAVIORS_HINT" format = center vertical_alignment = top alwaysTransparent = yes effect = "bca_tab_visible_2" }
        {{
        gsc.auto_demolition_row(name = "apply_all", text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ALL_AUTO_DEMOLITION",
            x = content_x, y = tab_content_y, width = full_width, height = demo_all_row_height,
            show_default = false,
            apply_enable_effect = "bca_global_settings_auto_destruction_all_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_all_disable",
            apply_enable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ALL_AUTO_DEMOLITION_ENABLE_TOOLTIP",
            apply_disable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ALL_AUTO_DEMOLITION_DISABLE_TOOLTIP",
            label_effect = "bca_tab_visible_2")
        }}
        {{
        gsc.auto_demolition_row(name = "buildings", text = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION",
            status_text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_BUILDING_AUTO_DEMOLITION_STATUS",
            x = content_x, y = tab_content_y + demo_all_row_height + demo_row_gap, width = full_width, height = demo_row_height,
            default_enable_current_effect = "bca_global_settings_default_auto_destruction_buildings_enable_current",
            default_enable_target_effect = "bca_global_settings_default_auto_destruction_buildings_enable",
            default_disable_current_effect = "bca_global_settings_default_auto_destruction_buildings_disable_current",
            default_disable_target_effect = "bca_global_settings_default_auto_destruction_buildings_disable",
            apply_enable_effect = "bca_global_settings_auto_destruction_buildings_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_buildings_disable",
            apply_enable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_BUILDING_AUTO_DEMOLITION_ENABLE_TOOLTIP",
            apply_disable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_BUILDING_AUTO_DEMOLITION_DISABLE_TOOLTIP",
            default_enable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_ON_CURRENT_TOOLTIP",
            default_enable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_ON_TARGET_TOOLTIP",
            default_disable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_OFF_CURRENT_TOOLTIP",
            default_disable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_OFF_TARGET_TOOLTIP",
            label_effect = "bca_tab_visible_2", status_effect = "bca_tab_visible_2")
        }}
        {{
        gsc.auto_demolition_row(name = "districts", text = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION",
            status_text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_DISTRICT_AUTO_DEMOLITION_STATUS",
            x = content_x, y = tab_content_y + demo_all_row_height + demo_row_gap + demo_row_height + demo_row_gap, width = full_width, height = demo_row_height,
            default_enable_current_effect = "bca_global_settings_default_auto_destruction_districts_enable_current",
            default_enable_target_effect = "bca_global_settings_default_auto_destruction_districts_enable",
            default_disable_current_effect = "bca_global_settings_default_auto_destruction_districts_disable_current",
            default_disable_target_effect = "bca_global_settings_default_auto_destruction_districts_disable",
            apply_enable_effect = "bca_global_settings_auto_destruction_districts_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_districts_disable",
            label_effect = "bca_tab_visible_2", status_effect = "bca_tab_visible_2",
            apply_enable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_DISTRICT_AUTO_DEMOLITION_ENABLE_TOOLTIP",
            apply_disable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_DISTRICT_AUTO_DEMOLITION_DISABLE_TOOLTIP",
            default_enable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_ON_CURRENT_TOOLTIP",
            default_enable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_ON_TARGET_TOOLTIP",
            default_disable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_OFF_CURRENT_TOOLTIP",
            default_disable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_OFF_TARGET_TOOLTIP")
        }}
        {{
        gsc.auto_demolition_row(name = "zones", text = "BCA_GLOBAL_SETTINGS_DEFAULT_ZONE_AUTO_DEMOLITION",
            status_text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ZONE_AUTO_DEMOLITION_STATUS",
            x = content_x, y = tab_content_y + demo_all_row_height + demo_row_gap + (demo_row_height + demo_row_gap) * 2, width = full_width, height = demo_row_height,
