{% set content_x = outer_padding_x %}
{% set content_left = content_x %}
{% set content_right = scroll_container_width - outer_padding_x %}
{% set content_width = content_right - content_left %}
{% set full_width = content_width %}

{# ---- Support overlay ---- #}
{% set support_panel_size = support_layout.panel_size %}
{% set support_panel_gap = support_layout.panel_gap %}
{% set window_width = scroll_container_width + window_gap * 2 %}
{% set window_height = scroll_container_bottom + window_gap %}
