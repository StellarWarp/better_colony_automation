        }}

        {% for row in bca_global_settings_reserve_rows %}
            {% set row_y = tab_content_y + demo_all_row_height + demo_row_gap + (demo_row_height + demo_row_gap) * 3 + behavior_row_gap + (behavior_row_height + behavior_row_gap) * 3 + reserve_row_gap + loop.index0 * (reserve_row_height + reserve_row_gap) %}
            {% set negative_options = [] %}
            {% for option in row.negative_options %}
                {% set _ = negative_options.append({"name": option.name, "text": option.text, "effect": row.effect_prefix ~ "_" ~ option.name}) %}
            {% endfor %}
            {% set positive_options = [] %}
            {% for option in row.positive_options %}
                {% set _ = positive_options.append({"name": option.name, "text": option.text, "effect": row.effect_prefix ~ "_" ~ option.name}) %}
            {% endfor %}
            {{
                gsc.multi_step_value_row(
                    name = "reserve_" ~ row.name, text = row.text, value_text = row.value_text,
                    tooltip = row.tooltip, value_effect = "",
                    negative_options = negative_options, positive_options = positive_options,
                    x = content_x, y = row_y, width = full_width, height = reserve_row_height,
                    value_width = 84, button_width = 46, button_gap = 6, control_gap = 8,
                    label_effect = "bca_tab_visible_2"
                )
            }}
        {% endfor %}
    }

