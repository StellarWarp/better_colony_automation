{% set panel_width = 860 %}
{% set panel_height = 850 %}
{% set outer_padding_x = 24 %}
{% set full_width = panel_width - outer_padding_x * 2 %}
{% set content_x = outer_padding_x %}

{% set scroll_container_y = 60 %}
{% set scroll_container_height = panel_height - scroll_container_y - 16 %}

{# ---- 统一 Tab 布局坐标 ---- #}
{% set tab_bar_y = 0 %}
{% set tab_section_y = 56 %}
{% set tab_hint_y = 90 %}
{% set tab_content_y = 132 %}

{# ---- Economy ---- #}
{% set economy_row_height = 32 %}
{% set economy_row_gap = 6 %}

{# ---- Demolition ---- #}
{% set demo_row_height = 44 %}
{% set demo_row_gap = 8 %}
{% set demo_all_row_height = 36 %}

{# ---- Behavior ---- #}
{% set behavior_row_height = 40 %}
{% set behavior_row_gap = 12 %}

{# ---- Reserve ---- #}
{% set reserve_row_height = 40 %}
{% set reserve_row_gap = 12 %}

{# ---- Jobs ---- #}
{% set jr_slots = job_regulation_config.display_slots | default(15) %}
