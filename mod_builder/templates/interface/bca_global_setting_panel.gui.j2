        {{
        gsc.sub_title(
            name = "reserve_hint",
            text = "BCA_GLOBAL_SETTINGS_RESOURCE_THRESHOLDS_HINT",
            x = left_column_x,
            y = lower_section_hint_y,
            width = column_width
        )
        }}
        {{
        gsc.value_adjust_row(
            name = "reserve_minerals",
            text = "BCA_GLOBAL_SETTINGS_MINERAL_RESERVE",
            value_text = "BCA_GLOBAL_SETTINGS_MINERAL_RESERVE_VALUE",
            tooltip = "BCA_GLOBAL_SETTINGS_MINERAL_RESERVE_TOOLTIP",
            decrease_effect = "bca_global_settings_reserve_minerals_decrease",
