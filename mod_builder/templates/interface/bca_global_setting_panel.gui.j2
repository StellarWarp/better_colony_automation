{% import 'component/event_gui_shell.j2' as shell %}
{% import 'component/global_settings_components.j2' as gsc %}

{% set panel_width = 860 %}
{% set panel_height = 848 %}
{% set outer_padding_x = 24 %}
{% set column_gap = 22 %}
{% set column_width = 395 %}
{% set full_width = panel_width - outer_padding_x * 2 %}
{% set left_column_x = outer_padding_x %}
{% set right_column_x = left_column_x + column_width + column_gap %}
{% set section_title_y = 88 %}
{% set section_hint_y = 124 %}
{% set first_row_y = 178 %}
{% set auto_demo_row_gap = 12 %}
{% set auto_demo_all_row_height = 44 %}
{% set auto_demo_row_height = 54 %}
{% set auto_demo_second_row_y = first_row_y + auto_demo_all_row_height + auto_demo_row_gap %}
{% set auto_demo_third_row_y = auto_demo_second_row_y + auto_demo_row_height + auto_demo_row_gap %}
{% set auto_demo_fourth_row_y = auto_demo_third_row_y + auto_demo_row_height + auto_demo_row_gap %}
{% set row_height = 40 %}
{% set row_gap = 14 %}
{% set lower_section_title_y = 432 %}
{% set lower_section_hint_y = 468 %}
{% set lower_first_row_y = 516 %}
{% set choice_row_gap = 12 %}
{% set lower_right_behavior_row_y = lower_first_row_y + (row_height + choice_row_gap) %}
{% set lower_right_testing_section_title_y = lower_right_behavior_row_y + row_height + 28 %}
{% set lower_right_testing_hint_y = lower_right_testing_section_title_y + 36 %}
{% set lower_right_testing_row_y = lower_right_testing_hint_y + 48 %}

{% set rare_building_choices = [
    {"name": "retain", "text": "BCA_GLOBAL_SETTINGS_OPTION_RETAIN", "effect": "bca_global_settings_retain_low_level_rare_resource_buildings", "tooltip": "BCA_GLOBAL_SETTINGS_LOW_TIER_RARE_RESOURCE_BUILDINGS_RETAIN_TOOLTIP"},
    {"name": "remove", "text": "BCA_GLOBAL_SETTINGS_OPTION_REMOVE", "effect": "bca_global_settings_remove_low_level_rare_resource_buildings", "tooltip": "BCA_GLOBAL_SETTINGS_LOW_TIER_RARE_RESOURCE_BUILDINGS_REMOVE_TOOLTIP"}
] %}
{% set pop_assembly_choices = [
    {"name": "always", "text": "BCA_GLOBAL_SETTINGS_OPTION_ALWAYS_BUILD", "effect": "bca_global_settings_pop_assemble_always", "tooltip": "BCA_GLOBAL_SETTINGS_POP_ASSEMBLY_BUILDINGS_ALWAYS_TOOLTIP"},
    {"name": "needed", "text": "BCA_GLOBAL_SETTINGS_OPTION_BUILD_WHEN_NEEDED", "effect": "bca_global_settings_pop_assemble_needed", "tooltip": "BCA_GLOBAL_SETTINGS_POP_ASSEMBLY_BUILDINGS_NEEDED_TOOLTIP"},
    {"name": "demolish", "text": "BCA_GLOBAL_SETTINGS_OPTION_AUTO_REMOVE", "effect": "bca_global_settings_pop_assemble_demolish", "tooltip": "BCA_GLOBAL_SETTINGS_POP_ASSEMBLY_BUILDINGS_DEMOLISH_TOOLTIP"}
] %}
{% set deurbanization_choices = [
    {"name": "off", "text": "BCA_GLOBAL_SETTINGS_DISABLED", "effect": "bca_global_settings_deurbanization_off"},
    {"name": "on", "text": "BCA_GLOBAL_SETTINGS_ENABLED", "effect": "bca_global_settings_deurbanization_on"}
] %}

{% call shell.event_window_shell(
    window_name = "bca_global_setting_panel",
    header_text = "BCA_GLOBAL_SETTINGS_HEADER",
    width = panel_width,
    height = panel_height,
    show_native_event_text = false
) %}
        {{
        gsc.section_title(
            name = "auto_demolition_section",
            text = "BCA_GLOBAL_SETTINGS_AUTO_DEMOLITION_SECTION",
            x = left_column_x,
            y = section_title_y,
            width = full_width
        )
        }}
        {{
        gsc.sub_title(
            name = "auto_demolition_hint",
            text = "BCA_GLOBAL_SETTINGS_AUTO_DEMOLITION_HINT",
            x = left_column_x,
            y = section_hint_y,
            width = full_width
        )
        }}
        {{
        gsc.auto_demolition_row(
            name = "apply_all",
            text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ALL_AUTO_DEMOLITION",
            x = left_column_x,
            y = first_row_y,
            width = full_width,
            height = auto_demo_all_row_height,
            show_default = false,
            apply_enable_effect = "bca_global_settings_auto_destruction_all_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_all_disable",
            apply_enable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ALL_AUTO_DEMOLITION_ENABLE_TOOLTIP",
            apply_disable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_ALL_AUTO_DEMOLITION_DISABLE_TOOLTIP"
        )
        }}
        {{
        gsc.auto_demolition_row(
            name = "buildings",
            text = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION",
            status_text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_BUILDING_AUTO_DEMOLITION_STATUS",
            default_enable_current_effect = "bca_global_settings_default_auto_destruction_buildings_enable_current",
            default_enable_target_effect = "bca_global_settings_default_auto_destruction_buildings_enable",
            default_disable_current_effect = "bca_global_settings_default_auto_destruction_buildings_disable_current",
            default_disable_target_effect = "bca_global_settings_default_auto_destruction_buildings_disable",
            default_enable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_ON_CURRENT_TOOLTIP",
            default_enable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_ON_TARGET_TOOLTIP",
            default_disable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_OFF_CURRENT_TOOLTIP",
            default_disable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_BUILDING_AUTO_DEMOLITION_OFF_TARGET_TOOLTIP",
            apply_enable_effect = "bca_global_settings_auto_destruction_buildings_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_buildings_disable",
            apply_enable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_BUILDING_AUTO_DEMOLITION_ENABLE_TOOLTIP",
            apply_disable_tooltip = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_BUILDING_AUTO_DEMOLITION_DISABLE_TOOLTIP",
            x = left_column_x,
            y = auto_demo_second_row_y,
            width = full_width,
            height = auto_demo_row_height
        )
        }}
        {{
        gsc.auto_demolition_row(
            name = "districts",
            text = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION",
            status_text = "BCA_GLOBAL_SETTINGS_EXISTING_PLANETS_DISTRICT_AUTO_DEMOLITION_STATUS",
            default_enable_current_effect = "bca_global_settings_default_auto_destruction_districts_enable_current",
            default_enable_target_effect = "bca_global_settings_default_auto_destruction_districts_enable",
            default_disable_current_effect = "bca_global_settings_default_auto_destruction_districts_disable_current",
            default_disable_target_effect = "bca_global_settings_default_auto_destruction_districts_disable",
            default_enable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_ON_CURRENT_TOOLTIP",
            default_enable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_ON_TARGET_TOOLTIP",
            default_disable_current_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_OFF_CURRENT_TOOLTIP",
            default_disable_target_tooltip = "BCA_GLOBAL_SETTINGS_DEFAULT_DISTRICT_AUTO_DEMOLITION_OFF_TARGET_TOOLTIP",
            apply_enable_effect = "bca_global_settings_auto_destruction_districts_enable",
            apply_disable_effect = "bca_global_settings_auto_destruction_districts_disable",
