            increase_text = "BCA_GLOBAL_SETTINGS_STEP_PLUS_2K",
            x = left_column_x,
            y = lower_first_row_y,
            width = column_width,
            height = row_height,
            value_width = 84,
            button_width = 58,
            button_gap = 8
        )
        }}
        {{
        gsc.value_adjust_row(
            name = "reserve_alloys",
            text = "BCA_GLOBAL_SETTINGS_ALLOY_RESERVE",
            value_text = "BCA_GLOBAL_SETTINGS_ALLOY_RESERVE_VALUE",
            tooltip = "BCA_GLOBAL_SETTINGS_ALLOY_RESERVE_TOOLTIP",
            decrease_effect = "bca_global_settings_reserve_alloys_decrease",
            increase_effect = "bca_global_settings_reserve_alloys_increase",
            decrease_tooltip = "BCA_GLOBAL_SETTINGS_ALLOY_RESERVE_DECREASE_TOOLTIP",
            increase_tooltip = "BCA_GLOBAL_SETTINGS_ALLOY_RESERVE_INCREASE_TOOLTIP",
            decrease_text = "BCA_GLOBAL_SETTINGS_STEP_MINUS_2K",
            increase_text = "BCA_GLOBAL_SETTINGS_STEP_PLUS_2K",
            x = left_column_x,
            y = lower_first_row_y + (row_height + choice_row_gap),
            width = column_width,
            height = row_height,
            value_width = 84,
            button_width = 58,
            button_gap = 8
        )
        }}
        {{
        gsc.value_adjust_row(
            name = "reserve_influence",
            text = "BCA_GLOBAL_SETTINGS_INFLUENCE_RESERVE",
            value_text = "BCA_GLOBAL_SETTINGS_INFLUENCE_RESERVE_VALUE",
            tooltip = "BCA_GLOBAL_SETTINGS_INFLUENCE_RESERVE_TOOLTIP",
            decrease_effect = "bca_global_settings_reserve_influence_decrease",
            increase_effect = "bca_global_settings_reserve_influence_increase",
            decrease_tooltip = "BCA_GLOBAL_SETTINGS_INFLUENCE_RESERVE_DECREASE_TOOLTIP",
            increase_tooltip = "BCA_GLOBAL_SETTINGS_INFLUENCE_RESERVE_INCREASE_TOOLTIP",
            decrease_text = "BCA_GLOBAL_SETTINGS_STEP_MINUS_100",
            increase_text = "BCA_GLOBAL_SETTINGS_STEP_PLUS_100",
            x = left_column_x,
            y = lower_first_row_y + (row_height + choice_row_gap) * 2,
            width = column_width,
            height = row_height,
            value_width = 84,
            button_width = 58,
            button_gap = 8
        )
        }}
        {{
        gsc.value_adjust_row(
            name = "reserve_job",
            text = "BCA_GLOBAL_SETTINGS_JOB_RESERVE",
            value_text = "BCA_GLOBAL_SETTINGS_JOB_RESERVE_VALUE",
            tooltip = "BCA_GLOBAL_SETTINGS_JOB_RESERVE_TOOLTIP",
            decrease_effect = "bca_global_settings_reserve_job_decrease",
            increase_effect = "bca_global_settings_reserve_job_increase",
            decrease_tooltip = "BCA_GLOBAL_SETTINGS_JOB_RESERVE_DECREASE_TOOLTIP",
            increase_tooltip = "BCA_GLOBAL_SETTINGS_JOB_RESERVE_INCREASE_TOOLTIP",
            decrease_text = "BCA_GLOBAL_SETTINGS_STEP_MINUS_50",
            increase_text = "BCA_GLOBAL_SETTINGS_STEP_PLUS_50",
            x = left_column_x,
            y = lower_first_row_y + (row_height + choice_row_gap) * 3,
            width = column_width,
            height = row_height,
            value_width = 84,
            button_width = 58,
            button_gap = 8
        )
        }}
        {{
        gsc.value_adjust_row(
            name = "rare_output",
            text = "BCA_GLOBAL_SETTINGS_RARE_RESOURCE_TARGET_SURPLUS",
            value_text = "BCA_GLOBAL_SETTINGS_RARE_RESOURCE_TARGET_SURPLUS_VALUE",
            tooltip = "BCA_GLOBAL_SETTINGS_RARE_RESOURCE_TARGET_SURPLUS_TOOLTIP",
            decrease_effect = "bca_global_settings_expect_output_rare_resource_decrease",
            increase_effect = "bca_global_settings_expect_output_rare_resource_increase",
            decrease_tooltip = "BCA_GLOBAL_SETTINGS_RARE_RESOURCE_TARGET_SURPLUS_DECREASE_TOOLTIP",
            increase_tooltip = "BCA_GLOBAL_SETTINGS_RARE_RESOURCE_TARGET_SURPLUS_INCREASE_TOOLTIP",
            decrease_text = "BCA_GLOBAL_SETTINGS_STEP_MINUS_20",
            increase_text = "BCA_GLOBAL_SETTINGS_STEP_PLUS_20",
            x = left_column_x,
            y = lower_first_row_y + (row_height + choice_row_gap) * 4,
            width = column_width,
            height = row_height,
            value_width = 84,
            button_width = 58,
            button_gap = 8
        )
        }}

        {{
        gsc.section_title(
            name = "behavior_section",
            text = "BCA_GLOBAL_SETTINGS_AUTOMATION_BEHAVIORS_SECTION",
            x = right_column_x,
            y = lower_section_title_y,
            width = column_width
        )
        }}
        {{
        gsc.sub_title(
            name = "behavior_hint",
            text = "BCA_GLOBAL_SETTINGS_AUTOMATION_BEHAVIORS_HINT",
            x = right_column_x,
            y = lower_section_hint_y,
            width = column_width
        )
        }}
        {{
        gsc.choice_row(
            name = "rare_buildings",
            text = "BCA_GLOBAL_SETTINGS_LOW_TIER_RARE_RESOURCE_BUILDINGS",
            tooltip = "BCA_GLOBAL_SETTINGS_LOW_TIER_RARE_RESOURCE_BUILDINGS_TOOLTIP",
            x = right_column_x,
            y = lower_first_row_y,
            width = column_width,
            height = row_height,
            button_width = 92,
            button_gap = 10,
            options = rare_building_choices
        )
        }}
        {{
        gsc.choice_row(
            name = "pop_assembly",
            text = "BCA_GLOBAL_SETTINGS_POP_ASSEMBLY_BUILDINGS",
