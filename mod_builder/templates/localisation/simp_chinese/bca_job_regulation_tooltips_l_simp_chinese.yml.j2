# submod job_regulation
{% set slots = job_regulation_config.display_slots | default(15) %}
{% set resources = job_regulation_config.resources %}
l_simp_chinese:
 BCA_JR_CHANGE_TENDENCY_INCREASE: "§R应增加岗位§!"
 BCA_JR_CHANGE_TENDENCY_DECREASE: "§G可减少岗位§!"
 BCA_JR_CHANGE_TENDENCY_STABLE: "§L无需调整§!"
{% for s in range(slots) %}
{% set s_name = "s%d" % (s + 1) %}
 BCA_JR_SLOT_{{ s_name }}_CHANGE_TOOLTIP: "§Y当前调控状态§!\n[From.BCA_JR_SLOT_{{ s_name }}_CHANGE_TENDENCY_script]\n\n§Y相关资源§!\n{% for resource in resources %}[From.BCA_JR_SLOT_{{ s_name }}_CHANGE_RESOURCE_{{ resource | upper }}_script]{% endfor %}"
 BCA_JR_SLOT_{{ s_name }}_WF_TOOLTIP: "§Y岗位劳动力§!\n[From.BCA_JR_SLOT_{{ s_name }}_FMT_TOTAL_JOB_COUNT_script] - 总岗位数量\n[From.BCA_JR_SLOT_{{ s_name }}_FMT_ASSIGNED_WORKFORCE_script] - 已分配人口劳动力\n[From.BCA_JR_SLOT_{{ s_name }}_FMT_OPEN_TOTAL_CAPACITY_script] - 已开放岗位容量（含自动化）\n[From.BCA_JR_SLOT_{{ s_name }}_FMT_FREE_JOB_COUNT_script] - 空闲开放岗位\n\n§Y产出劳动力§!\n[From.BCA_JR_SLOT_{{ s_name }}_TOTAL_PRODUCTIVE_COLORED_script] - 总产出劳动力\n    [From.BCA_JR_SLOT_{{ s_name }}_POP_PRODUCTIVE_COLORED_script] - 人口产出劳动力\n        [From.BCA_JR_SLOT_{{ s_name }}_FMT_CAPACITY_WORKFORCE_script] - 人口劳动力\n        [From.BCA_JR_SLOT_{{ s_name }}_POP_DELTA_COLORED_script] - 人口岗位效率\n    [From.BCA_JR_SLOT_{{ s_name }}_AUTO_PRODUCTIVE_COLORED_script] - 自动化产出劳动力\n        §L[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATED_CAPACITY_WORKFORCE_script]§! - 自动化劳动力\n        [From.BCA_JR_SLOT_{{ s_name }}_AUTO_DELTA_COLORED_script] - 自动化效率"
{% endfor %}
