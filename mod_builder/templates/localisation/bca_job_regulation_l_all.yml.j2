# submod job_regulation
{#
Phase 8: job-regulation panel batch localisation (all: fan out to every language).

This file is only for keys that must be generated from job/resource/slot
configuration and whose rendered content is identical in every language.
Language-specific generated text belongs under localisation/<language>/.
#}
{% set slots = job_regulation_config.display_slots | default(15) %}
{% set regulated = job_regulation_config.regulated_jobs %}
{% set resources = job_regulation_config.resources %}
{% set display_numbers = [
    "active_workforce",
    "assigned_workforce",
    "capacity_workforce",
    "pop_productive_workforce",
    "productive_workforce",
    "automated_capacity_workforce",
    "automated_productive_workforce",
    "pop_capacity_limit",
    "total_job_count",
    "free_job_count",
    "open_job_count",
    "open_total_capacity",
    "automation_rate",
    "pop_efficiency_delta",
    "automated_efficiency_delta",
    "total_efficiency_delta",
    "closable_capacity_workforce",
    "job_change",
] %}
{% macro formatted_number_keys(s_name, number) %}
 BCA_JR_SLOT_{{ s_name }}_FMT_{{ number | upper }}: "[From.BCA_JR_SLOT_{{ s_name }}_FMT_{{ number | upper }}_VALUE_script][From.BCA_JR_SLOT_{{ s_name }}_FMT_{{ number | upper }}_UNIT_script]"
{% endmacro %}
all:

 BCA_JR_DISPLAY_UNIT_K: "K"
 BCA_JR_DISPLAY_UNIT_M: "M"
 BCA_JR_DISPLAY_UNIT_EMPTY: ""

{% for icon in job_regulation_config.icon_sprites | default([]) %}
 BCA_JR_ICON_SPRITE_{{ icon }}: "£jr_icon_{{ icon }}£"
{% endfor %}
{% for resource in resources %}
 BCA_JR_CHANGE_RESOURCE_{{ resource | upper }}_NEEDED: "§R●§! £{{ resource }}£\n"
 BCA_JR_CHANGE_RESOURCE_{{ resource | upper }}_SURPLUS: "§G●§! £{{ resource }}£\n"
 BCA_JR_CHANGE_RESOURCE_{{ resource | upper }}_SATISFIED: "§L●§! £{{ resource }}£\n"
{% endfor %}

{% for s in range(slots) %}
{% set s_name = "s%d" % (s + 1) %}
 BCA_JR_SLOT_{{ s_name }}_ICON: "[From.BCA_JR_SLOT_{{ s_name }}_ICON_script]"
 BCA_JR_SLOT_{{ s_name }}_NAME: "[From.BCA_JR_SLOT_{{ s_name }}_NAME_script]"
 BCA_JR_SLOT_{{ s_name }}_WF: "[From.BCA_JR_SLOT_{{ s_name }}_FMT_ACTIVE_WORKFORCE_script] / [From.BCA_JR_SLOT_{{ s_name }}_FMT_TOTAL_JOB_COUNT_script]"
 BCA_JR_SLOT_{{ s_name }}_CHANGE: "[From.BCA_JR_SLOT_{{ s_name }}_CHANGE_script]"
 BCA_JR_SLOT_{{ s_name }}_CHANGE_POSITIVE: "§G+[From.BCA_JR_SLOT_{{ s_name }}_FMT_JOB_CHANGE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_CHANGE_NEGATIVE: "§R[From.BCA_JR_SLOT_{{ s_name }}_FMT_JOB_CHANGE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_CHANGE_ZERO: "[From.BCA_JR_SLOT_{{ s_name }}_FMT_JOB_CHANGE_script]"
 BCA_JR_SLOT_{{ s_name }}_RATE: "[From.BCA_JR_SLOT_{{ s_name }}_RATE_script]"
 BCA_JR_SLOT_{{ s_name }}_RATE_VALUE: "§L[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATION_RATE_script]%§!"
 BCA_JR_SLOT_{{ s_name }}_TOTAL_PRODUCTIVE_GREEN: "§G[From.BCA_JR_SLOT_{{ s_name }}_FMT_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_TOTAL_PRODUCTIVE_RED: "§R[From.BCA_JR_SLOT_{{ s_name }}_FMT_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_TOTAL_PRODUCTIVE_WHITE: "§W[From.BCA_JR_SLOT_{{ s_name }}_FMT_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_POP_PRODUCTIVE_GREEN: "§G[From.BCA_JR_SLOT_{{ s_name }}_FMT_POP_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_POP_PRODUCTIVE_RED: "§R[From.BCA_JR_SLOT_{{ s_name }}_FMT_POP_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_POP_PRODUCTIVE_WHITE: "§W[From.BCA_JR_SLOT_{{ s_name }}_FMT_POP_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_POP_DELTA_GREEN: "§G+[From.BCA_JR_SLOT_{{ s_name }}_FMT_POP_EFFICIENCY_DELTA_script]§!"
 BCA_JR_SLOT_{{ s_name }}_POP_DELTA_RED: "§R[From.BCA_JR_SLOT_{{ s_name }}_FMT_POP_EFFICIENCY_DELTA_script]§!"
 BCA_JR_SLOT_{{ s_name }}_POP_DELTA_WHITE: "§W+0§!"
 BCA_JR_SLOT_{{ s_name }}_AUTO_PRODUCTIVE_GREEN: "§G[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATED_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_AUTO_PRODUCTIVE_RED: "§R[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATED_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_AUTO_PRODUCTIVE_HIGHLIGHT: "§H[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATED_PRODUCTIVE_WORKFORCE_script]§!"
 BCA_JR_SLOT_{{ s_name }}_AUTO_DELTA_GREEN: "§G+[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATED_EFFICIENCY_DELTA_script]§!"
 BCA_JR_SLOT_{{ s_name }}_AUTO_DELTA_RED: "§R[From.BCA_JR_SLOT_{{ s_name }}_FMT_AUTOMATED_EFFICIENCY_DELTA_script]§!"
 BCA_JR_SLOT_{{ s_name }}_AUTO_DELTA_WHITE: "§W+0§!"
{% for number in display_numbers %}
{{ formatted_number_keys(s_name, number) }}
{% endfor %}
{% for resource in resources %}
{{ formatted_number_keys(s_name, "output_" ~ resource) }}
 BCA_JR_SLOT_{{ s_name }}_OUTPUT_{{ resource | upper }}: "£{{ resource }}£[From.BCA_JR_SLOT_{{ s_name }}_FMT_OUTPUT_{{ resource | upper }}_script] "
{% endfor %}
 BCA_JR_SLOT_{{ s_name }}_OUTPUT: "{% for resource in resources %}[From.BCA_JR_SLOT_{{ s_name }}_OUTPUT_{{ resource | upper }}_script]{% endfor %}"
{% endfor %}
