{# Phase 8: 岗位调控面板本地化（all: 自动分发） #}
{% set slots = job_regulation_config.display_slots | default(15) %}
{% set regulated = job_regulation_config.regulated_jobs %}
all:

{% for icon in job_regulation_config.icon_sprites | default([]) %}
 BCA_JR_ICON_SPRITE_{{ icon }}: "£jr_icon_{{ icon }}£"
{% endfor %}

{% for entry in regulated %}
 BCA_JR_WF_{{ entry.job }}: "[From.bca_jr_total_capacity_workforce_{{ entry.job }}] / [From.bca_jr_total_job_count_{{ entry.job }}]"
{% endfor %}

{% for entry in regulated %}
 BCA_JR_OUTPUT_{{ entry.job }}: "{% for resource in entry.economic_resources %}£{{ resource }}£[From.bca_jr_display_output_{{ entry.job }}_{{ resource }}]{% if not loop.last %} {% endif %}{% endfor %}"
{% endfor %}

{% for s in range(slots) %}
{% set s_name = "s%d" % (s + 1) %}
 BCA_JR_SLOT_{{ s_name }}_ICON: "[From.BCA_JR_SLOT_{{ s_name }}_ICON_script]"
 BCA_JR_SLOT_{{ s_name }}_NAME: "[From.BCA_JR_SLOT_{{ s_name }}_NAME_script]"
 BCA_JR_SLOT_{{ s_name }}_WF: "[From.BCA_JR_SLOT_{{ s_name }}_WF_script]"
 BCA_JR_SLOT_{{ s_name }}_OUTPUT: "[From.BCA_JR_SLOT_{{ s_name }}_OUTPUT_script]"
{% endfor %}
