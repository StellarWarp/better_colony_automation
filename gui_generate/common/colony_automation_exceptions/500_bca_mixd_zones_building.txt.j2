{% if item.efficiency or item.always %}
automate_mixed_zone_{{ item.types[0] }}_building = {
	category = "planet_automation_designation_construction"

	emergency = yes
	available = {
		bca_has_minerals_to_build = yes
		NOT = { has_planet_flag = bca_pf_advance_controller_order }
        OR = {
		    {% for type in item.types %}
            bca_has_zone_of_type_{{ type }} = yes
{#		    {% for zone_slot in ['z1','z2','z3','z4','z5'] %}#}
{#	        has_planet_flag = {{ pf.flag_selected_zone_type(zone_slot, type) }}#}
{#		    {% endfor %}#}
		    {% endfor %}
		}
	}

	buildings = {
        {% for building in item.efficiency %}
	    {{ loop.index0 }} = {
            {#  #}{{building_config(building)}}{#  #}
			available = {
				OR = {
					really_requires_more_job = no
					free_district_slots = 0
				}
			}
	    }
        {% endfor %}

        {% for building in item.always %}
	    {{ loop.index0 + item.efficiency|length }} = {
            {#  #}{{building_config(building)}}{#  #}
	    }
        {% endfor %}

        {% if item.job_only and not item.job_building_available_for_at_least_one_zone%}
        {% for building in item.job_only %}
        {{ loop.index0 + item.efficiency|length + item.always|length }} = {
            {#  #}{{building_config(building)}}{#  #}
            available = {
                requires_more_job = yes
                free_district_slots = 0
            }
        }
        {% endfor %}
	    {% endif %}

	}
}

{% if item.job_building_available_for_at_least_one_zone and item.job_only %}
